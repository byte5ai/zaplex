{
  "schema_version": 1,
  "contract": "GH-160",
  "gate_issue": 169,
  "required_dimensions": {
    "provider": [
      "claude",
      "codex"
    ],
    "account": [
      "default",
      "pinned",
      "multiple"
    ],
    "location": [
      "local",
      "remote"
    ],
    "state": [
      "live",
      "waiting",
      "idle",
      "dormant"
    ]
  },
  "required_capabilities": [
    "api",
    "launch",
    "reattach",
    "transcript",
    "usage",
    "attention",
    "lifecycle"
  ],
  "references": [
    {
      "id": "claudeplex",
      "repository": "iret77/claudeplex",
      "url": "https://github.com/iret77/claudeplex.git",
      "branch": "main",
      "probes": [
        {
          "id": "account-roots-include-process-and-environment",
          "path": "src/discover.ts",
          "contains_regex": [
            "getRunningConfigDirs\\(\\)\\.keys\\(\\)",
            "process\\.env\\.CLAUDE_CONFIG_DIR"
          ]
        },
        {
          "id": "live-sessions-require-registry-and-transcript",
          "path": "src/collect.ts",
          "contains_regex": [
            "isRealReg\\(r\\)",
            "jsonlById\\.has\\(r\\.sessionId\\)",
            "pidAlive\\(r\\.pid\\)"
          ]
        },
        {
          "id": "status-and-dormant-contract",
          "path": "src/collect.ts",
          "contains_regex": [
            "status === [\"']busy[\"']",
            "ended \\? [\"']wartet[\"'] : [\"']monitor[\"']",
            "live: false",
            "state: [\"']stale[\"']"
          ]
        }
      ]
    },
    {
      "id": "claudeplex-desktop",
      "repository": "iret77/claudeplex-desktop",
      "url": "https://github.com/iret77/claudeplex-desktop.git",
      "branch": "main",
      "probes": [
        {
          "id": "account-roots-include-process-and-environment",
          "path": "src/core/discover.ts",
          "contains_regex": [
            "getRunningConfigDirs\\(\\)\\.keys\\(\\)",
            "process\\.env\\.CLAUDE_CONFIG_DIR"
          ]
        },
        {
          "id": "live-sessions-require-registry-and-transcript",
          "path": "src/core/collect.ts",
          "contains_regex": [
            "isRealReg\\(r\\)",
            "jsonlById\\.has\\(r\\.sessionId\\)",
            "pidAlive\\(r\\.pid\\)"
          ]
        },
        {
          "id": "status-dormant-and-attention-contract",
          "path": "src/core/collect.ts",
          "contains_regex": [
            "status === [\"']busy[\"']",
            "ended \\? [\"']wartet[\"'] : [\"']monitor[\"']",
            "live: false",
            "state: [\"']stale[\"']"
          ]
        },
        {
          "id": "waiting-sessions-are-surfaced",
          "path": "src/views/SessionsMain.tsx",
          "contains_regex": [
            "s\\.state === [\"']wartet[\"']",
            "waitingOnYou"
          ]
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "cargo-check",
      "command": [
        "cargo",
        "check",
        "--locked",
        "--bin",
        "zaplex"
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "cockpit-data-spine",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "zaplex_cockpit",
        "--lib",
        "--no-fail-fast"
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "cockpit-app",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "warp",
        "--lib",
        "--no-fail-fast",
        "cockpit::"
      ],
      "timeout_seconds": 5400
    },
    {
      "id": "remote-daemon-app",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "warp",
        "--lib",
        "--no-fail-fast",
        "remote_server::"
      ],
      "timeout_seconds": 5400
    },
    {
