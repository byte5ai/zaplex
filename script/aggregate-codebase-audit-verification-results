#!/usr/bin/env python3

"""Validate and aggregate immutable codebase-audit verification results."""

from __future__ import annotations

import argparse
import copy
import datetime
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import subprocess
import sys
import tempfile
from typing import Any


SCHEMA_VERSION = 1
AGGREGATOR_VERSION = 1
GENERATOR_VERSION = 1
RUNNER_VERSION = 2
BUCKET_COUNT = 3
LENSES = ("disprove", "impact", "reproduction-fix")
REQUIRED_MODEL = "gpt-5.6-sol"
REQUIRED_REASONING_EFFORT = "xhigh"
SEVERITIES = {"P0", "P1", "P2", "P3"}
CONFIDENCES = {"low", "medium", "high"}
AGGREGATE_KEYS = {
    "schema_version",
    "aggregator_version",
    "manifest_sha256",
    "inventory_sha256",
    "scope_sha256",
    "assignment_sha256",
    "run_summary_sha256",
    "target_sha",
    "upstream_sha",
    "merge_base_sha",
    "bucket_results",
    "findings",
    "coverage",
    "remaining_ranges",
    "aggregate_sha256",
}
AGGREGATE_COVERAGE_KEYS = {
    "assigned_ranges",
    "reviewed_ranges",
    "assigned_lines",
    "reviewed_lines",
    "bucket_count",
    "complete",
}
ORIGINAL_BUCKET_KEYS = {
    "bucket_assignment_sha256",
    "bucket_id",
    "finding_count",
    "result_sha256",
}
FINDING_KEYS = {
    "bucket_id",
    "path",
    "range",
    "category",
    "severity",
    "evidence",
    "scenario",
    "fix",
    "confidence",
}
ISSUE_KEYS = {
    "number",
    "title",
    "body",
    "state",
    "url",
    "updated_at",
    "labels",
}
PROVENANCE_KEYS = {
    "schema_version",
    "aggregator_version",
    "manifest_sha256",
    "inventory_sha256",
    "scope_sha256",
    "assignment_sha256",
    "run_summary_sha256",
    "aggregate_sha256",
    "target_sha",
    "upstream_sha",
    "merge_base_sha",
    "bucket_results",
    "coverage",
    "remaining_ranges",
}
ASSIGNMENT_ROOT_KEYS = {
    "schema_version",
    "generator_version",
    "aggregate_sha256",
    "issue_snapshot_sha256",
    "github_repository",
    "provenance",
    "issue_snapshot",
    "finding_count",
    "lens_count",
    "bucket_count",
    "coverage",
    "buckets",
    "assignment_sha256",
}
ASSIGNMENT_COVERAGE_KEYS = {
    "findings",
    "lenses_per_finding",
    "expected_tuples",
    "assigned_tuples",
    "complete",
}
ASSIGNMENT_BUCKET_KEYS = {"id", "tuple_count", "entries", "assignment_sha256"}
ASSIGNMENT_ENTRY_KEYS = {
    "verification_id",
    "finding_id",
    "lens",
    "aggregate_sha256",
    "issue_snapshot_sha256",
    "github_repository",
    "finding",
    "provenance",
    "issue_snapshot",
}
RUN_ROOT_KEYS = {
    "schema_version",
    "runner_version",
    "assignment_sha256",
    "assignments_input_sha256",
    "aggregate_sha256",
    "aggregate_input_sha256",
    "issue_snapshot_sha256",
    "issue_snapshot_input_sha256",
    "github_repository",
    "provenance",
    "generator_stdout_sha256",
    "generator_stderr_sha256",
    "model",
    "reasoning_effort",
    "bucket_count",
    "expected_tuples",
