#!/usr/bin/env python3

"""Enforce immutable release inputs, actions, source commits, and tool downloads."""

from __future__ import annotations

from pathlib import Path
import re
import sys


REPO_ROOT = Path(__file__).resolve().parent.parent
WORKFLOW_ROOTS = (REPO_ROOT / ".github" / "workflows", REPO_ROOT / ".github" / "actions")
INPUT_SHELL_FILES = (
    REPO_ROOT / ".github" / "workflows" / "zap_release.yml",
    REPO_ROOT / ".github" / "workflows" / "test-dmg.yml",
    REPO_ROOT / ".github" / "workflows" / "build-remote-server.yml",
    REPO_ROOT / ".github" / "actions" / "prepare_environment" / "action.yml",
)
ACTION_USE = re.compile(r"^\s*(?:-\s+)?uses:\s*([^\s#]+)@([^\s#]+)")
IMMUTABLE_ACTION_REF = re.compile(r"^[0-9a-f]{40}$")
INPUT_EXPRESSION = "${{ inputs."
CHECKOUT_USE = re.compile(r"^(?P<indent>\s*)(?:-\s+)?uses:\s*actions/checkout@")
REPOSITORY_TOKEN = re.compile(
    r"\b(?:GH_TOKEN|GITHUB_TOKEN)\b|\$\{\{\s*(?:github\.token|secrets\.GITHUB_TOKEN)\s*\}\}"
)


def label(path: Path) -> str:
    return str(path.relative_to(REPO_ROOT))


def workflow_files() -> list[Path]:
    files: list[Path] = []
    for root in WORKFLOW_ROOTS:
        files.extend(root.glob("**/*.yml"))
        files.extend(root.glob("**/*.yaml"))
    return sorted(set(files))


def checkout_credential_errors(text: str, source: str) -> list[str]:
    errors = []
    lines = text.splitlines()
    for index, line in enumerate(lines):
        match = CHECKOUT_USE.match(line)
        if match is None:
            continue
        step_indent = len(match.group("indent"))
        end = index + 1
        while end < len(lines):
            stripped = lines[end].lstrip()
            child_indent = len(lines[end]) - len(stripped)
            if stripped and (
                child_indent < step_indent
                or (child_indent == step_indent and stripped.startswith("- "))
            ):
                break
            end += 1
        step = "\n".join(lines[index:end])
        if re.search(r"(?m)^\s+persist-credentials:\s*false\s*$", step) is None:
            errors.append(
                f"{source}:{index + 1}: checkout must set persist-credentials: false"
            )
    return errors


def validate_checkout_credentials(paths: list[Path]) -> list[str]:
    errors = []
    for path in paths:
        errors.extend(
            checkout_credential_errors(path.read_text(encoding="utf-8"), label(path))
        )
    return errors


def prepare_environment_token_errors(text: str, source: str) -> list[str]:
    for line_number, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith("#"):
            continue
        if REPOSITORY_TOKEN.search(line) is not None:
            return [
                f"{source}:{line_number}: shared environment setup must not receive or export a repository token"
            ]
    return []


def validate_prepare_environment_token_scope() -> list[str]:
    path = REPO_ROOT / ".github" / "actions" / "prepare_environment" / "action.yml"
    return prepare_environment_token_errors(path.read_text(encoding="utf-8"), label(path))


def strip_yaml_comment(line: str) -> str:
    return re.sub(r"\s+#.*$", "", line).rstrip()


def unquote_yaml_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def permission_blocks(
    text: str, source: str
) -> tuple[list[tuple[int, int, dict[str, str]]], list[str]]:
    blocks = []
    errors = []
    lines = text.splitlines()
    for index, line in enumerate(lines):
        code = strip_yaml_comment(line)
        stripped = code.lstrip()
        match = re.fullmatch(r"permissions:\s*(.*)", stripped)
        if match is None:
            continue
        indent = len(code) - len(stripped)
        scalar = unquote_yaml_value(match.group(1))
        if scalar:
            if scalar not in ("read-all", "write-all"):
                errors.append(f"{source}:{index + 1}: invalid permissions scalar")
            blocks.append((index, indent, {"*": scalar}))
            continue

        values = {}
        for child_index in range(index + 1, len(lines)):
            child_code = strip_yaml_comment(lines[child_index])
            child_stripped = child_code.lstrip()
            child_indent = len(child_code) - len(child_stripped)
            if child_stripped and child_indent <= indent:
                break
            if not child_stripped:
                continue
            entry = re.fullmatch(r"([a-z-]+):\s*(.+)", child_stripped)
            if child_indent != indent + 2 or entry is None:
                errors.append(
                    f"{source}:{child_index + 1}: invalid permissions entry"
                )
                continue
            value = unquote_yaml_value(entry.group(2))
            if value not in ("read", "write", "none"):
                errors.append(
                    f"{source}:{child_index + 1}: invalid permissions value"
                )
            values[entry.group(1)] = value
        blocks.append((index, indent, values))
    return blocks, errors


def release_permission_errors(text: str, source: str) -> list[str]:
    blocks, errors = permission_blocks(text, source)
    lines = text.splitlines()
    publisher_start = next(
        (index for index, line in enumerate(lines) if line == "  publish_release:"),
        len(lines),
    )
    publisher_end = next(
        (
            index
            for index in range(publisher_start + 1, len(lines))
            if re.fullmatch(r"  [a-zA-Z0-9_-]+:", lines[index])
        ),
        len(lines),
    )

    top_level = next((values for _, indent, values in blocks if indent == 0), None)
    if top_level != {"contents": "read"}:
        errors.append(f"{source}: workflow permissions must be limited to contents: read")

    publisher_permissions = next(
        (
            values
            for index, indent, values in blocks
            if publisher_start < index < publisher_end and indent == 4
        ),
        None,
    )
    if publisher_permissions != {"contents": "write", "actions": "write"}:
        errors.append(
            f"{source}: publish_release must exclusively declare contents/actions write"
        )

    if any(
        any(value in ("write", "write-all") for value in values.values())
        for index, _, values in blocks
        if not publisher_start < index < publisher_end
    ):
        errors.append(f"{source}: write permissions are forbidden outside publish_release")
    return errors


def validate_release_permissions() -> list[str]:
    path = REPO_ROOT / ".github" / "workflows" / "zap_release.yml"
    return release_permission_errors(path.read_text(encoding="utf-8"), label(path))


def readonly_permission_errors(text: str, source: str) -> list[str]:
    blocks, errors = permission_blocks(text, source)
    top_level = next((values for _, indent, values in blocks if indent == 0), None)
    if top_level != {"contents": "read"}:
        errors.append(f"{source}: workflow permissions must be limited to contents: read")
    if any(
        any(value in ("write", "write-all") for value in values.values())
        for _, _, values in blocks
    ):
        errors.append(f"{source}: write permissions are forbidden")
    return errors


def validate_readonly_workflow_permissions() -> list[str]:
    errors = []
    for name in ("test-dmg.yml", "build-remote-server.yml"):
        path = REPO_ROOT / ".github" / "workflows" / name
        errors.extend(readonly_permission_errors(path.read_text(encoding="utf-8"), label(path)))
    return errors


def workflow_token_scope_errors(text: str, source: str) -> list[str]:
    errors = []
    lines = text.splitlines()
    for index, line in enumerate(lines):
        code = strip_yaml_comment(line)
        stripped = code.lstrip()
        indent = len(code) - len(stripped)
        if "GITHUB_ENV" in code and REPOSITORY_TOKEN.search(code) is not None:
            errors.append(f"{source}:{index + 1}: repository token exported globally")
        if stripped != "env:" or indent not in (0, 4):
            continue
        for child_index in range(index + 1, len(lines)):
            child = strip_yaml_comment(lines[child_index])
            child_stripped = child.lstrip()
            child_indent = len(child) - len(child_stripped)
            if child_stripped and child_indent <= indent:
                break
            if REPOSITORY_TOKEN.search(child) is not None:
                errors.append(
                    f"{source}:{child_index + 1}: repository token forbidden in workflow/job env"
                )
    return errors


def validate_workflow_token_scopes() -> list[str]:
    errors = []
    root = REPO_ROOT / ".github" / "workflows"
    for path in sorted((*root.glob("*.yml"), *root.glob("*.yaml"))):
        errors.extend(workflow_token_scope_errors(path.read_text(encoding="utf-8"), label(path)))
    return errors


def validate_action_pins(paths: list[Path]) -> list[str]:
    errors = []
    for path in paths:
        for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            match = ACTION_USE.match(line)
            if match is None or match.group(1).startswith("./"):
                continue
            if IMMUTABLE_ACTION_REF.fullmatch(match.group(2)) is None:
                errors.append(
                    f"{label(path)}:{line_number}: action must use a 40-character commit SHA"
                )
    return errors


def direct_inputs_in_run_blocks(path: Path) -> list[str]:
    errors = []
    lines = path.read_text(encoding="utf-8").splitlines()
    index = 0
    while index < len(lines):
        line = lines[index]
        stripped = line.lstrip()
        indent = len(line) - len(stripped)
        if not stripped.startswith("run:"):
            index += 1
            continue

        if INPUT_EXPRESSION in stripped:
            errors.append(f"{label(path)}:{index + 1}: action input embedded directly in shell")
        index += 1
        while index < len(lines):
            child = lines[index]
            child_stripped = child.lstrip()
            child_indent = len(child) - len(child_stripped)
            if child_stripped and child_indent <= indent:
                break
            if INPUT_EXPRESSION in child:
                errors.append(
                    f"{label(path)}:{index + 1}: action input embedded directly in shell"
                )
            index += 1
    return errors


def require_order(path: Path, before: str, after: str) -> list[str]:
    text = path.read_text(encoding="utf-8")
    errors = []
    if before not in text:
        errors.append(f"{label(path)}: missing integrity check {before!r}")
    if after not in text:
        errors.append(f"{label(path)}: missing extraction step {after!r}")
    if before in text and after in text and text.index(before) > text.index(after):
        errors.append(f"{label(path)}: integrity check must precede extraction")
    return errors


def validate_installers() -> list[str]:
    errors = []
    zig = REPO_ROOT / "script" / "install_zig"
    cargo_bundle = REPO_ROOT / "script" / "install_cargo_bundle"
    protoc = REPO_ROOT / "script" / "windows" / "install_protoc.ps1"

    required_literals = {
        zig: (
            "0.13.0",
            "d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea",
        ),
        cargo_bundle: (
            "ae4c76e92c08774bf54ff077b1c52e3d1cd6c16d",
            "fae87673dba366bdad287782589ba2c06a2a151c21908d1170a4710dccf045cd",
            "cargo install --locked --path",
        ),
        protoc: (
            "25.1",
            "b55901fc748d1679f3a803bdc2a920e1897eb02433c501b5a589ea08c4623844",
        ),
    }
    for path, literals in required_literals.items():
        text = path.read_text(encoding="utf-8")
        for literal in literals:
            if literal not in text:
                errors.append(f"{label(path)}: missing pinned value {literal!r}")

    errors.extend(require_order(zig, "sha256sum --check", "tar -xJf"))
    errors.extend(require_order(cargo_bundle, "shasum -a 256 -c", "tar -xzf"))
    errors.extend(require_order(protoc, "Get-FileHash", "Expand-Archive"))

    prepare_environment = (
        REPO_ROOT / ".github" / "actions" / "prepare_environment" / "action.yml"
    ).read_text(encoding="utf-8")
    for forbidden in ("choco: protoc", "winget install Google.Protobuf"):
        if forbidden in prepare_environment:
            errors.append(f"prepare_environment still uses mutable protoc source {forbidden!r}")

    for workflow_name in ("zap_release.yml", "test-dmg.yml", "build-remote-server.yml"):
        text = (REPO_ROOT / ".github" / "workflows" / workflow_name).read_text(
            encoding="utf-8"
        )
        if "script/install_zig" not in text:
            errors.append(f".github/workflows/{workflow_name}: must use script/install_zig")
        if "cargo-zigbuild --version '=0.19.8'" not in text:
            errors.append(f".github/workflows/{workflow_name}: cargo-zigbuild must be exact")
    return errors


def validate_source_sha_contract() -> list[str]:
    errors = []
    release = (REPO_ROOT / ".github" / "workflows" / "zap_release.yml").read_text(
        encoding="utf-8"
    )
    if "release_branch" in release:
        errors.append("zap_release.yml: mutable release_branch output is forbidden")
    if release.count("ref: ${{ needs.prepare_metadata.outputs.release_sha }}") != 5:
        errors.append("zap_release.yml: every release checkout must use the resolved release SHA")

    if "target_commitish: ${{ needs.prepare_metadata.outputs.release_sha }}" not in release:
        errors.append("zap_release.yml: new release tags must use the resolved release SHA")

    test_dmg = (REPO_ROOT / ".github" / "workflows" / "test-dmg.yml").read_text(
        encoding="utf-8"
    )
    if test_dmg.count("ref: ${{ needs.readiness.outputs.source_sha }}") != 4:
        errors.append("test-dmg.yml: every downstream checkout must use the resolved source SHA")
    return errors


def self_test() -> list[str]:
    errors = []
    if IMMUTABLE_ACTION_REF.fullmatch("v4") is not None:
        errors.append("floating action self-test was accepted")
    if IMMUTABLE_ACTION_REF.fullmatch("a" * 40) is None:
        errors.append("immutable action self-test was rejected")
    action_match = ACTION_USE.match("  - uses: example/action@v1")
    if action_match is None or IMMUTABLE_ACTION_REF.fullmatch(action_match.group(2)):
        errors.append("dash-prefixed floating action self-test was accepted")

    unsafe_checkout = """steps:
  - uses: actions/checkout@abc
  - run: cargo check
"""
    safe_checkout = """steps:
  - uses: actions/checkout@abc
    with:
      fetch-depth: 0
      persist-credentials: false
"""
    cross_job_checkout = """jobs:
  unsafe:
    steps:
      - uses: actions/checkout@abc
  safe:
    steps:
      - name: Checkout
        uses: actions/checkout@abc
        with:
          persist-credentials: false
"""
    same_job_checkout = """steps:
  - uses: actions/checkout@abc
  - uses: actions/checkout@abc
    with:
      persist-credentials: false
"""
    if not checkout_credential_errors(unsafe_checkout, "fixture.yml"):
        errors.append("checkout credential self-test accepted persisted credentials")
    if checkout_credential_errors(safe_checkout, "fixture.yml"):
        errors.append("checkout credential self-test rejected non-persisted credentials")
    if len(checkout_credential_errors(cross_job_checkout, "fixture.yml")) != 1:
        errors.append("checkout credential self-test crossed step or job boundaries")
    if len(checkout_credential_errors(same_job_checkout, "fixture.yml")) != 1:
        errors.append("checkout credential self-test crossed sibling step boundaries")

    unsafe_prepare = """steps:
  - run: echo \"GH_TOKEN=$TOKEN\" >> \"$GITHUB_ENV\"
"""
    if not prepare_environment_token_errors(unsafe_prepare, "fixture.yml"):
        errors.append("environment token self-test accepted a global token export")
    if prepare_environment_token_errors("steps:\n  - run: cargo check\n", "fixture.yml"):
        errors.append("environment token self-test rejected a token-free action")

    unsafe_global_token = """env:
  GH_TOKEN: ${{ github.token }}
jobs: {}
"""
    safe_step_token = """jobs:
  inspect:
    steps:
      - run: gh api rate_limit
        env:
          GH_TOKEN: ${{ github.token }}
"""
    if not workflow_token_scope_errors(unsafe_global_token, "fixture.yml"):
        errors.append("workflow token self-test accepted a global repository token")
    if workflow_token_scope_errors(safe_step_token, "fixture.yml"):
        errors.append("workflow token self-test rejected a step-scoped repository token")

    safe_permissions = """permissions:
  contents: read
jobs:
  build:
    steps: []
  publish_release:
    permissions:
      contents: write
      actions: write
    steps: []
"""
    unsafe_permissions = safe_permissions.replace("contents: read", "contents: write", 1)
    unsafe_build_permissions = safe_permissions.replace(
        "  build:\n    steps: []",
        "  build:\n    permissions:\n      contents: write\n    steps: []",
    )
    unsafe_build_write_all = safe_permissions.replace(
        "  build:\n    steps: []",
        "  build:\n    permissions: write-all\n    steps: []",
    )
    unsafe_commented_write = safe_permissions.replace(
        "  build:\n    steps: []",
        "  build:\n    permissions:  # temporary\n      contents: \"write\"  # upload\n    steps: []",
    )
    unsafe_publisher_extra = safe_permissions.replace(
        "      actions: write",
        "      actions: write\n      id-token: write",
    )
    if release_permission_errors(safe_permissions, "fixture.yml"):
        errors.append("release permission self-test rejected least-privilege permissions")
    if not release_permission_errors(unsafe_permissions, "fixture.yml"):
        errors.append("release permission self-test accepted workflow-wide write access")
    if not release_permission_errors(unsafe_build_permissions, "fixture.yml"):
        errors.append("release permission self-test accepted build-job write access")
    if not release_permission_errors(unsafe_build_write_all, "fixture.yml"):
        errors.append("release permission self-test accepted build-job write-all access")
    if not release_permission_errors(unsafe_commented_write, "fixture.yml"):
        errors.append("release permission self-test accepted commented or quoted write access")
    if not release_permission_errors(unsafe_publisher_extra, "fixture.yml"):
        errors.append("release permission self-test accepted extra publisher permissions")

    readonly_permissions = "permissions:\n  contents: read\njobs: {}\n"
    if readonly_permission_errors(readonly_permissions, "fixture.yml"):
        errors.append("read-only permission self-test rejected contents read")
    if not readonly_permission_errors("jobs: {}\n", "fixture.yml"):
        errors.append("read-only permission self-test accepted missing permissions")
    return errors


def main() -> int:
    if sys.argv[1:] not in ([], ["--self-test"]):
        print("usage: script/check-release-supply-chain [--self-test]", file=sys.stderr)
        return 2

    errors = self_test() if sys.argv[1:] == ["--self-test"] else []
    errors.extend(validate_action_pins(workflow_files()))
    for path in INPUT_SHELL_FILES:
        errors.extend(direct_inputs_in_run_blocks(path))
    errors.extend(validate_checkout_credentials(workflow_files()))
    errors.extend(validate_prepare_environment_token_scope())
    errors.extend(validate_workflow_token_scopes())
    errors.extend(validate_release_permissions())
    errors.extend(validate_readonly_workflow_permissions())
    errors.extend(validate_installers())
    errors.extend(validate_source_sha_contract())

    if errors:
        for error in errors:
            print(f"release supply chain: {error}", file=sys.stderr)
        return 1

    print("release supply chain: ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
