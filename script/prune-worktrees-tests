#!/usr/bin/env python3
"""Exercise pruning against isolated local Git remotes; never touch real worktrees."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

SCRIPT = Path(__file__).resolve().with_name('prune-worktrees')


class PruneWorktreesTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='zaplex-prune-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.remote = self.root / 'remote.git'
        self.repo = self.root / 'main anchor with spaces'
        template = self.root / 'empty-template'
        template.mkdir()
        self.env = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
        self.env.update(GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull,
                        GIT_TEMPLATE_DIR=str(template), GIT_TERMINAL_PROMPT='0')
        self.git(self.root, 'init', '--bare', str(self.remote))
        self.git(self.root, 'init', '-b', 'main', str(self.repo))
        self.git(self.repo, 'config', 'user.name', 'Prune fixture')
        self.git(self.repo, 'config', 'user.email', 'fixture@example.invalid')
        (self.repo / 'script').mkdir()
        shutil.copyfile(SCRIPT, self.repo / 'script/prune-worktrees')
        self.git(self.repo, 'add', '.')
        self.git(self.repo, 'commit', '-m', 'fixture baseline')
        self.git(self.repo, 'remote', 'add', 'origin', str(self.remote))
        self.git(self.repo, 'push', '-u', 'origin', 'main')

    def git(self, cwd, *args):
        result = subprocess.run(['git', '-C', str(cwd), *args], env=self.env,
                                text=True, capture_output=True)
        if result.returncode:
            self.fail(f'git {args}: {result.stderr}')
        return result.stdout.strip()

    def worktree(self, branch, unpublished=False):
        path = self.root / branch
        self.git(self.repo, 'worktree', 'add', '-b', branch, str(path), 'main')
        if unpublished:
            (path / 'valuable.txt').write_text(branch)
            self.git(path, 'add', 'valuable.txt')
            self.git(path, 'commit', '-m', 'unmerged work')
        return path

    def prune(self, *args):
        return subprocess.run(['bash', str(self.repo / 'script/prune-worktrees'), *args],
                              cwd=self.repo, env=self.env, text=True, capture_output=True)

    def test_unpublished_deleted_remote_and_local_ahead_work_survive(self):
        unpublished = self.worktree('unpublished', unpublished=True)
        deleted = self.worktree('deleted-remote', unpublished=True)
        self.git(self.repo, 'push', 'origin', 'deleted-remote')
        self.git(self.repo, 'push', 'origin', '--delete', 'deleted-remote')
        ahead = self.worktree('local-ahead')
        self.git(self.repo, 'push', '-u', 'origin', 'local-ahead')
        (ahead / 'valuable.txt').write_text('local-ahead')
        self.git(ahead, 'add', '.')
        self.git(ahead, 'commit', '-m', 'unpublished after remote merged')
        completed = self.worktree('completed')
        (completed / 'merged.txt').write_text('merged work')
        self.git(completed, 'add', '.')
        self.git(completed, 'commit', '-m', 'completed work')
        self.git(self.repo, 'merge', '--ff-only', 'completed')
        self.git(self.repo, 'push', 'origin', 'main')
        dirty = self.worktree('dirty')
        (dirty / 'untracked.txt').write_text('keep me')
        saved = {path: self.git(path, 'rev-parse', 'HEAD') for path in (unpublished, deleted, ahead)}

        result = self.prune('--yes', '--batch')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertFalse(completed.exists(), result.stdout)
        self.assertTrue(self.repo.exists(), 'main anchor with spaces must be preserved')
        self.assertTrue((dirty / 'untracked.txt').exists())
        for path, commit in saved.items():
            with self.subTest(branch=path.name):
                self.assertTrue(path.exists(), result.stdout)
                self.assertEqual((path / 'valuable.txt').read_text(), path.name)
                self.assertEqual(self.git(path, 'rev-parse', 'HEAD'), commit)
                self.assertEqual(self.git(self.repo, 'rev-parse', f'refs/heads/{path.name}'), commit)

    def test_branch_changed_during_confirmation_preserves_the_new_checkout(self):
        completed = self.worktree('completed')
        process = subprocess.Popen(
            ['bash', str(self.repo / 'script/prune-worktrees'), '--yes'],
            cwd=self.repo, env=self.env, text=True, stdin=subprocess.PIPE,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
        self.addCleanup(lambda: process.kill() if process.poll() is None else None)
        transcript = ''
        while not transcript.endswith('[y/N] '):
            character = process.stdout.read(1)
            self.assertTrue(character, transcript)
            transcript += character
        self.git(completed, 'switch', '-c', 'new-unmerged-work')
        (completed / 'valuable.txt').write_text('keep switched checkout')
        self.git(completed, 'add', '.')
        self.git(completed, 'commit', '-m', 'new work during confirmation')
        output, _ = process.communicate('y\n', timeout=10)
        self.assertEqual(process.returncode, 0, transcript + output)
        self.assertTrue(completed.exists(), transcript + output)
        self.assertEqual((completed / 'valuable.txt').read_text(), 'keep switched checkout')
        self.assertEqual(self.git(completed, 'branch', '--show-current'), 'new-unmerged-work')

    def test_failed_fetch_removes_nothing_even_with_stale_merged_refs(self):
        completed = self.worktree('completed')
        self.git(self.repo, 'remote', 'set-url', 'origin', str(self.root / 'missing.git'))
        result = self.prune('--yes', '--batch')
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('cannot prove', result.stderr)
        self.assertTrue(completed.exists())
        self.git(self.repo, 'rev-parse', 'refs/heads/completed')

    def test_dry_run_preserves_completed_worktree_and_branch(self):
        completed = self.worktree('completed')
        result = self.prune()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('Candidates (1)', result.stdout)
        self.assertTrue(completed.exists())
        self.git(self.repo, 'rev-parse', 'refs/heads/completed')


if __name__ == '__main__':
    unittest.main()
