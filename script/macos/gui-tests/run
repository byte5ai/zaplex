#!/bin/bash
set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
art=${1:?Usage: run ARTIFACT_DIRECTORY}
suite=${2:-full}
selection=${3:-}
# Positional arguments also expand safely when empty under macOS Bash 3.2 + nounset.
set --
case "$suite" in
  full) expected=15 ;;
  terminal)
    expected=3
    set -- -only-testing:ZaplexUITests/SmokeTests -skip-testing:ZaplexUITests/SmokeTests/testNativeCloseButtonClosesWindow
    ;;
  navigation)
    expected=8
    set -- -only-testing:ZaplexUITests/NavigationTests
    ;;
  surfaces)
    expected=3
    set -- -only-testing:ZaplexUITests/SurfaceTests
    ;;
  *) echo "Unknown suite: $suite" >&2; exit 2 ;;
esac
if [[ -n "$selection" ]]; then
  [[ "$suite" != full ]] || { echo "Full acceptance cannot select individual cases" >&2; exit 2; }
  /usr/bin/python3 "$root/report.py" --validate-selection "$selection"
  IFS=, read -r -a cases <<< "$selection"
  set --
  for testcase in "${cases[@]}"; do
    set -- "$@" "-only-testing:ZaplexUITests/$testcase"
  done
  expected=${#cases[@]}
  suite=selected
fi
mkdir -p "$art"
art=$(cd "$art" && pwd)
printf '%s\n' "$suite" > "$art/suite.txt"
printf '%s\n' "$selection" > "$art/selected-cases.txt"
work=$(mktemp -d)
cp -R "$root/project.yml" "$root/ZaplexUITests" "$work/"

macrunner-gui-check --prepare --screenshot "$art/desktop.png"
cat /Users/Shared/macrunner-image.txt > "$art/runner-image.txt"
xcodebuild -version > "$art/xcode.txt"
sw_vers > "$art/macos.txt"

xcodegen generate --spec "$work/project.yml"
xcodebuild build-for-testing -project "$work/ZaplexGUI.xcodeproj" -scheme ZaplexGUI \
  -destination 'platform=macOS' -derivedDataPath "$work/build" \
  > "$art/build-tests.log" 2>&1

shopt -s nullglob
bundles=("$work"/build/Build/Products/*.xctestrun)
[[ ${#bundles[@]} -eq 1 ]] || { echo "Expected exactly one xctestrun file" >&2; exit 1; }

set +e
macrunner-gui-run --timeout 540 --artifacts "$art/gui" -- \
  xcodebuild test-without-building -xctestrun "${bundles[0]}" \
  -destination 'platform=macOS' -parallel-testing-enabled NO \
  -resultBundlePath "$art/tests.xcresult" "$@" > "$art/tests.log" 2>&1
result=$?
set -e

if [[ -d "$art/tests.xcresult" ]]; then
  xcrun xcresulttool export attachments --path "$art/tests.xcresult" --output-path "$art/attachments"
  xcrun xcresulttool get test-results summary --path "$art/tests.xcresult" > "$art/summary.json"
  xcrun xcresulttool get test-results tests --path "$art/tests.xcresult" > "$art/test-cases.json"
  # A green xcodebuild with no matching tests must never pass the gate.
  /usr/bin/python3 "$root/report.py" "$art" "$suite" "$expected" "$result"
else
  echo "No XCTest result bundle was produced" >&2
  exit 1
fi
exit "$result"
