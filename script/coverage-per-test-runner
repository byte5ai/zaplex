#!/usr/bin/env bash
# Cargo target runner for the per-test coverage attribution run (#472).
#
# nextest starts every test process through the target runner. This wrapper
# gives that process's LLVM profiles a prefix derived from the test binary and
# test name, so coverage can be attributed per test afterwards. The profiles
# stay in the directory cargo-llvm-cov already uses and keep its file pattern,
# so the aggregate report is unchanged. It never fails a test: anything it
# cannot attribute runs exactly as it would without the wrapper.
set -u

binary="${1:-}"
name=""
listing=false
for arg in "${@:2}"; do
    case "$arg" in
        --list) listing=true ;;
        -*) ;;
        *) [ -z "$name" ] && name="$arg" ;;
    esac
done

if [ "$listing" = false ] && [ -n "$name" ] \
    && [ -n "${LLVM_PROFILE_FILE:-}" ] && [ -n "${PER_TEST_COVERAGE_MANIFEST:-}" ]; then
    binary_name="$(basename "$binary")"
    key="$(printf '%s\t%s' "$binary_name" "$name" | sha256sum | cut -c1-16)"
    if [ -n "$key" ]; then
        export LLVM_PROFILE_FILE
        LLVM_PROFILE_FILE="$(dirname "$LLVM_PROFILE_FILE")/pt-$key-$(basename "$LLVM_PROFILE_FILE")"
        printf '%s\t%s\t%s\n' "$key" "$binary_name" "$name" >> "$PER_TEST_COVERAGE_MANIFEST" 2>/dev/null || true
    fi
fi

exec "$@"
