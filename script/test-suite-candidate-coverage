#!/usr/bin/env python3
"""Measure the suite without the #472 pruning candidates in the same CI run.

The per-test attribution run names each test process's LLVM profiles
`pt-<key>-*.profraw` (script/coverage-per-test-runner) and records
`key<TAB>binary<TAB>test` in its manifest. This script

  set-aside  moves the candidates' profiles out of the coverage target dir and
             writes a JUnit report without the candidates' test cases,
  restore    moves the profiles back,
  compare    compares the baseline summary with the summary of the suite
             without the candidates (both from script/test-suite-evidence).

`cargo llvm-cov report` merges only the `*.profraw` files directly in the
target dir, so a report between set-aside and restore covers exactly the
remaining tests of the same build. Nothing is deleted.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

HASH_SUFFIX = re.compile(r"-[0-9a-f]{16}$")


class MeasurementError(Exception):
    pass


def read_candidates(path):
    candidates = set()
    for number, line in enumerate(Path(path).read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 2 or not all(parts):
            raise MeasurementError(f"{path}:{number}: expected <binary>TAB<test>")
        if tuple(parts) in candidates:
            raise MeasurementError(f"{path}:{number}: duplicate candidate")
        candidates.add(tuple(parts))
    if not candidates:
        raise MeasurementError(f"{path}: no candidates")
    return candidates


def read_manifest(path):
    rows = []
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            rows.append(tuple(parts))
    if not rows:
        raise MeasurementError(f"{path}: empty per-test manifest")
    return rows


def junit_target(suite_name):
    """nextest binary id -> test binary name as the runner records it (no hash)."""
    if "::" in suite_name:
        target = suite_name.split("::", 1)[1]
        return target[4:] if target.startswith("bin/") else target
    return suite_name.replace("-", "_")


def set_aside(candidates_path, manifest_path, target_dir, aside_dir, junit_path, candidate_dir):
    candidates = read_candidates(candidates_path)
    manifest = read_manifest(manifest_path)
    target_dir, aside_dir, candidate_dir = Path(target_dir), Path(aside_dir), Path(candidate_dir)
    if not target_dir.is_dir():
        raise MeasurementError(f"coverage target dir missing: {target_dir}")
    if aside_dir.exists() and any(aside_dir.iterdir()):
        raise MeasurementError(f"set-aside dir is not empty: {aside_dir}")

    keys, matched = set(), set()
    for key, binary, name in manifest:
        test = (HASH_SUFFIX.sub("", binary), name)
        if test in candidates:
            keys.add(key)
            matched.add(test)
    if not keys:
        raise MeasurementError("no candidate appears in the per-test manifest")

    aside_dir.mkdir(parents=True, exist_ok=True)
    moved, keys_with_profiles = 0, set()
    for profile in sorted(target_dir.glob("pt-*.profraw")):
        key = profile.name[3:19]
        if key in keys:
            os.replace(profile, aside_dir / profile.name)
            moved += 1
            keys_with_profiles.add(key)
    if not moved:
        raise MeasurementError("no candidate profile found in the coverage target dir")

    tree = ET.parse(junit_path)
    root = tree.getroot()
    removed, removed_seconds = set(), 0.0
    for suite in root.iter("testsuite"):
        target = junit_target(suite.get("name", ""))
        for case in list(suite.findall("testcase")):
            if (target, case.get("name")) in candidates:
                suite.remove(case)
                removed.add((target, case.get("name")))
                removed_seconds += float(case.get("time") or 0)
        suite.set("tests", str(len(suite.findall("testcase"))))
    root.set("tests", str(sum(len(s.findall("testcase")) for s in root.iter("testsuite"))))
    if removed != matched:
        raise MeasurementError(
            f"manifest and JUnit disagree: {len(matched)} candidates ran, {len(removed)} JUnit cases removed")
    candidate_dir.mkdir(parents=True, exist_ok=True)
    tree.write(candidate_dir / "junit.xml", encoding="UTF-8", xml_declaration=True)

    selection = {
        "candidates_listed": len(candidates),
        "candidates_executed": len(matched),
        "candidates_not_executed": sorted("\t".join(t) for t in candidates - matched),
        "profile_keys": len(keys),
        "profile_keys_without_profiles": len(keys - keys_with_profiles),
        "profiles_set_aside": moved,
        "junit_cases_removed": len(removed),
        "removed_summed_test_seconds": removed_seconds,
    }
    (candidate_dir / "selection.json").write_text(json.dumps(selection, indent=2) + "\n")
    return selection


def restore(aside_dir, target_dir):
    aside_dir, target_dir = Path(aside_dir), Path(target_dir)
    if not aside_dir.is_dir():
        return 0
    restored = 0
    for profile in sorted(aside_dir.iterdir()):
        destination = target_dir / profile.name
        if destination.exists():
            raise MeasurementError(f"refusing to overwrite {destination}")
        os.replace(profile, destination)
        restored += 1
    aside_dir.rmdir()
    return restored


def load_evidence_module():
    path = Path(__file__).with_name("test-suite-evidence")
    loader = importlib.machinery.SourceFileLoader("suite_evidence", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def compare(baseline_path, candidate_path, selection_path):
    baseline = json.loads(Path(baseline_path).read_text())
    candidate = json.loads(Path(candidate_path).read_text())
    selection = json.loads(Path(selection_path).read_text())
    for key in ("production_policy_sha256", "production_source_fingerprints", "source_line_ids",
                "unresolved_production_lines", "provenance"):
        if baseline.get(key) != candidate.get(key):
            raise MeasurementError(f"baseline and candidate are not comparable: {key} differs")
    proven = all(s["production_projection_status"] == "pass" for s in (baseline, candidate))
    basis = "source_line_coverage_percent" if proven else "partial_known_line_coverage_percent"
    before, after = baseline[basis], candidate[basis]
    tests_before, tests_after = baseline["executed_rust_tests"], candidate["executed_rust_tests"]
    if tests_before - tests_after != selection["candidates_executed"]:
        raise MeasurementError("executed test counts do not match the candidate selection")
    loss = before - after
    result = {
        "commit": baseline["provenance"]["commit"],
        "run_url": baseline["provenance"]["run_url"],
        "coverage_basis": basis,
        "production_projection_status": baseline["production_projection_status"],
        "unresolved_production_lines": len(baseline["unresolved_production_lines"]),
        "baseline_executed_tests": tests_before,
        "candidate_executed_tests": tests_after,
        "test_reduction_percent": 100 * (1 - tests_after / tests_before),
        "baseline_line_coverage_percent": before,
        "candidate_line_coverage_percent": after,
        "line_coverage_loss_percentage_points": loss,
        "baseline_covered_source_lines": baseline["covered_source_lines"],
        "candidate_covered_source_lines": candidate["covered_source_lines"],
        "source_lines": baseline["source_lines"],
        "baseline_summed_test_seconds": baseline["summed_test_seconds"],
        "candidate_summed_test_seconds": candidate["summed_test_seconds"],
        "summed_test_seconds_saved": baseline["summed_test_seconds"] - candidate["summed_test_seconds"],
        "wall_seconds_note": "candidate wall time is not measured; both suites ran in one execution",
        "numeric_thresholds_met": tests_after * 5 <= tests_before * 4 and loss <= 2,
        "selection": {k: v for k, v in selection.items() if k != "candidates_not_executed"},
        "candidates_not_executed": selection["candidates_not_executed"],
    }
    if proven:
        result["repo_compare"] = load_evidence_module().compare(candidate, baseline)
    return result


def self_test():
    with tempfile.TemporaryDirectory() as raw:
        tmp = Path(raw)
        (tmp / "candidates.tsv").write_text("# comment\nwarp\tmod::tests::a\nwarp_cli\tx::tests::b\n")
        (tmp / "manifest.tsv").write_text(
            "aaaaaaaaaaaaaaaa\twarp-0123456789abcdef\tmod::tests::a\n"
            "bbbbbbbbbbbbbbbb\twarp-0123456789abcdef\tmod::tests::keep\n"
            "cccccccccccccccc\twarp_cli-fedcba9876543210\tx::tests::b\n")
        target = tmp / "target"
        target.mkdir()
        for name in ("pt-aaaaaaaaaaaaaaaa-warp-1-2.profraw", "pt-bbbbbbbbbbbbbbbb-warp-3-4.profraw",
                     "pt-cccccccccccccccc-warp_cli-5-6.profraw", "warp-7-8.profraw"):
            (target / name).write_text("x")
        (tmp / "junit.xml").write_text(
            '<testsuites tests="3"><testsuite name="warp" tests="2">'
            '<testcase name="mod::tests::a" time="1.5"/><testcase name="mod::tests::keep" time="1"/>'
            '</testsuite><testsuite name="warp_cli" tests="1"><testcase name="x::tests::b" time="0.5"/>'
            '</testsuite></testsuites>')
        selection = set_aside(tmp / "candidates.tsv", tmp / "manifest.tsv", target, tmp / "aside",
                              tmp / "junit.xml", tmp / "candidate")
        remaining = sorted(p.name for p in target.iterdir())
        junit = ET.parse(tmp / "candidate" / "junit.xml").getroot()
        checks = [
            selection["profiles_set_aside"] == 2 and selection["candidates_executed"] == 2,
            remaining == ["pt-bbbbbbbbbbbbbbbb-warp-3-4.profraw", "warp-7-8.profraw"],
            junit.get("tests") == "1" and selection["removed_summed_test_seconds"] == 2.0,
        ]
        checks.append(restore(tmp / "aside", target) == 2 and len(list(target.iterdir())) == 4)
        common = {"production_policy_sha256": "p", "production_source_fingerprints": {"a.rs": "f"},
                  "source_line_ids": ["a.rs:1", "a.rs:2"], "unresolved_production_lines": {"b.rs:1": "x"},
                  "provenance": {"commit": "c", "run_url": "u"}, "production_projection_status": "unproven",
                  "source_lines": 2, "source_line_coverage_percent": None}
        base = dict(common, executed_rust_tests=3, covered_source_lines=2,
                    partial_known_line_coverage_percent=100.0, summed_test_seconds=3.0)
        cand = dict(common, executed_rust_tests=1, covered_source_lines=1,
                    partial_known_line_coverage_percent=50.0, summed_test_seconds=1.0)
        (tmp / "base.json").write_text(json.dumps(base))
        (tmp / "cand.json").write_text(json.dumps(cand))
        result = compare(tmp / "base.json", tmp / "cand.json", tmp / "candidate" / "selection.json")
        checks.append(result["line_coverage_loss_percentage_points"] == 50.0
                      and result["numeric_thresholds_met"] is False
                      and result["coverage_basis"] == "partial_known_line_coverage_percent")
        (tmp / "cand.json").write_text(json.dumps(dict(cand, source_line_ids=["a.rs:1"])))
        try:
            compare(tmp / "base.json", tmp / "cand.json", tmp / "candidate" / "selection.json")
            checks.append(False)
        except MeasurementError:
            checks.append(True)
        (tmp / "empty.tsv").write_text("# nothing\n")
        try:
            read_candidates(tmp / "empty.tsv")
            checks.append(False)
        except MeasurementError:
            checks.append(True)
    if not all(checks):
        print(f"candidate coverage self-test failed: {checks}", file=sys.stderr)
        return 1
    print("candidate coverage self-test: ok")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--self-test", action="store_true")
    sub = parser.add_subparsers(dest="command")
    aside = sub.add_parser("set-aside")
    for name in ("--candidates", "--manifest", "--target-dir", "--aside-dir", "--junit", "--candidate-dir"):
        aside.add_argument(name, required=True)
    back = sub.add_parser("restore")
    back.add_argument("--aside-dir", required=True)
    back.add_argument("--target-dir", required=True)
    comp = sub.add_parser("compare")
    for name in ("--baseline", "--candidate", "--selection", "--output"):
        comp.add_argument(name, required=True)
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    try:
        if args.command == "set-aside":
            result = set_aside(args.candidates, args.manifest, args.target_dir, args.aside_dir,
                               args.junit, args.candidate_dir)
            print(json.dumps({k: v for k, v in result.items() if k != "candidates_not_executed"}, indent=2))
        elif args.command == "restore":
            print(f"restored {restore(args.aside_dir, args.target_dir)} profiles")
        elif args.command == "compare":
            result = compare(args.baseline, args.candidate, args.selection)
            Path(args.output).write_text(json.dumps(result, indent=2, allow_nan=False) + "\n")
            print(json.dumps({k: v for k, v in result.items() if k != "candidates_not_executed"}, indent=2))
        else:
            parser.error("a subcommand or --self-test is required")
    except (OSError, ValueError, KeyError, ET.ParseError, MeasurementError) as error:
        parser.exit(1, f"candidate coverage measurement failed: {error}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
