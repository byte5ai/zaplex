#!/usr/bin/env python3
"""Negative controls for reuse of previously passed CI gates."""

import copy
from pathlib import Path
import runpy
import unittest


module = runpy.run_path(str(Path(__file__).resolve().with_name("ci-batch-resume")))
validate = module["validate"]
validate_test_inputs = module["validate_test_inputs"]


class ResumeTests(unittest.TestCase):
    def setUp(self):
        self.run = {
            "status": "completed", "conclusion": "failure", "event": "workflow_dispatch",
            "head_branch": "main", "path": ".github/workflows/ci-batch.yml",
            "head_repository": {"full_name": "byte5ai/zaplex"},
        }
        self.jobs = [{"name": name, "conclusion": "success"} for name in (
            "dependency_security / cargo deny check advisories",
            "compile_checks / detect build-relevant changes",
            "compile_checks / cargo check (Linux x86_64)",
            "compile_checks / cargo check (macOS Apple Silicon)",
            "compile_checks / keymap validation (Linux x86_64)",
            "live_sftp / OpenSSH/SFTP commit-boundary recovery",
        )]
        self.jobs.append({"name": "tests / cargo test (Linux)", "conclusion": "failure", "steps": [
            {"name": "Isolated package tests", "conclusion": "failure"},
            {"name": "Package documentation tests", "conclusion": "success"},
            {"name": "Rust workspace coverage tests", "conclusion": "skipped"},
        ]})

    def test_runner_fix_and_evidence_only_can_reuse(self):
        validate(self.run, self.jobs, ["script/run-shell-ssh-fixtures", "specs/GH-564/evidence/image.png"])

    def test_missing_or_failed_gates_are_not_reused(self):
        for index in range(6):
            with self.subTest(index=index):
                missing = copy.deepcopy(self.jobs)
                del missing[index]
                with self.assertRaises(ValueError):
                    validate(self.run, missing, [])
                failed = copy.deepcopy(self.jobs)
                failed[index]["conclusion"] = "failure"
                with self.assertRaises(ValueError):
                    validate(self.run, failed, [])

    def test_wrong_run_context_is_rejected(self):
        for key, value in (("head_branch", "feature"), ("event", "pull_request"),
                           ("status", "in_progress"), ("conclusion", "success"),
                           ("head_repository", {"full_name": "other/repository"})):
            with self.subTest(key=key), self.assertRaises(ValueError):
                validate({**self.run, key: value}, self.jobs, [])

    def test_failed_docs_or_coverage_cannot_use_package_resume(self):
        for index, result in ((1, "failure"), (1, "skipped"), (2, "success")):
            changed = copy.deepcopy(self.jobs)
            changed[-1]["steps"][index]["conclusion"] = result
            with self.subTest(index=index, result=result), self.assertRaises(ValueError):
                validate(self.run, changed, [])

    def test_changed_build_inputs_require_revalidation(self):
        for path in ("app/src/main.rs", "Cargo.lock", "Cargo.toml", "rust-toolchain.toml",
                     ".github/workflows/pr-check.yml", ".github/actions/prepare_environment/action.yml",
                     "script/run-live-sftp-safety"):
            with self.subTest(path=path), self.assertRaises(ValueError):
                validate(self.run, self.jobs, [path])

    def test_ambiguous_duplicate_jobs_are_rejected(self):
        with self.assertRaises(ValueError):
            validate(self.run, self.jobs + [self.jobs[0]], [])

    def test_changed_package_environment_or_doc_command_is_rejected(self):
        inputs = "".join(f"      {name}:\n        default: {value}\n" for name, value in (
            ("package", "warp"), ("filter", "''"), ("coverage", "false"), ("per_test_coverage", "false"),
        ))
        previous = "on:\n  workflow_call:\n    inputs:\n" + inputs + """permissions:
  contents: read
env:
  CHANNEL: oss
jobs:
  test:
    name: cargo test (Linux)
    steps:
      - name: Isolated package tests
        run: cargo nextest run --locked -p warp
      - name: Package documentation tests
        if: ${{ !inputs.coverage && !cancelled() }}
        run: cargo test --locked --doc -p warp
"""
        current = previous.replace("    steps:", "    env:\n      ZAPLEX_TEST_RUNNER_LABEL: ${{ inputs.runs_on }}\n    steps:")
        current = current.replace("!inputs.coverage &&", "!inputs.coverage && inputs.run_doc_tests &&")
        validate_test_inputs(previous, current)
        for old, new in (("CHANNEL: oss", "CHANNEL: stable"), ("default: warp", "default: warpui"),
                         ("--doc -p warp", "--doc -p warp --all-features")):
            with self.subTest(old=old), self.assertRaises(ValueError):
                validate_test_inputs(previous, current.replace(old, new))


    def macos_jobs(self):
        jobs = copy.deepcopy(self.jobs[:5])
        jobs[3]["conclusion"] = "failure"
        return jobs

    def test_macos_failure_reuses_only_proven_linux_gates(self):
        self.assertEqual(validate(self.run, self.macos_jobs(), [
            "script/prepare-macos-rust", ".github/actions/prepare_environment/action.yml",
        ]), "linux")
        for index in (0, 1, 2, 4):
            for result in ("failure", "skipped", None):
                jobs = self.macos_jobs()
                jobs[index]["conclusion"] = result
                with self.subTest(index=index, result=result), self.assertRaises(ValueError):
                    validate(self.run, jobs, [])
        with self.assertRaises(ValueError):
            validate(self.run, self.macos_jobs()[1:], [])

    def test_macos_resume_rejects_app_changes_and_executed_downstream(self):
        for path in ("Cargo.lock", "Cargo.toml", "rust-toolchain.toml", "app/src/main.rs",
                     ".github/workflows/dependency-security.yml", ".github/workflows/test-dispatch.yml"):
            with self.subTest(path=path), self.assertRaises(ValueError):
                validate(self.run, self.macos_jobs(), [path])
        for stage in ("tests / cargo test (Linux)", "live_sftp / OpenSSH/SFTP commit-boundary recovery",
                      "test_dmg / build", "remote_server / build"):
            with self.subTest(stage=stage), self.assertRaises(ValueError):
                validate(self.run, self.macos_jobs() + [{"name": stage, "conclusion": "success"}], [])

    def test_linux_inputs_keep_shared_setup_and_commands_identical(self):
        compile_path = ".github/workflows/pr-check.yml"
        action = ".github/actions/prepare_environment/action.yml"
        batch = ".github/workflows/ci-batch.yml"
        previous = {
            compile_path: "on:\n  workflow_call:\nenv:\n  CHANNEL: oss\njobs:\n"
                "  cargo_check:\n    if: always() && needs.changes.result == 'success'\n"
                "    steps:\n      - run: cargo clippy --locked --bin zaplex -- -D warnings\n",
            action: "steps:\n    - name: Install rustup (macOS runners without Rust)\n"
                "      if: ${{ inputs.target_os == 'macos' }}\n      run: old-installer\n\n"
                "    - uses: cache@pinned\n      with:\n        key: unchanged\n",
            batch: "jobs:\n  dependency_security:\n    if: old-condition\n"
                "    uses: ./.github/workflows/dependency-security.yml\n\n"
                "  compile_checks:\n    if: old-condition\n"
                "    uses: ./.github/workflows/pr-check.yml\n",
        }
        current = dict(previous)
        current[compile_path] = current[compile_path].replace("  workflow_call:\n", "  workflow_call:\n" + module["LINUX_INPUT"])
        current[compile_path] = current[compile_path].replace("always() && ", "always() && !inputs.reuse_linux_checks && ")
        current[action] = current[action].replace("Install rustup (macOS runners without Rust)", "Prepare macOS Rust tools").replace("old-installer", "bash script/prepare-macos-rust")
        current[batch] = current[batch].replace("if: old-condition", "if: >\n      new-condition")
        current[batch] += "    with:\n      reuse_linux_checks: ${{ needs.preflight.outputs.reuse_linux_checks == 'true' }}\n"
        verify = module["validate_linux_inputs"]
        verify(previous, current)
        for path, old, new in (
            (compile_path, "CHANNEL: oss", "CHANNEL: stable"),
            (compile_path, "--bin zaplex", "--bin zaplex --all-features"),
            (action, "key: unchanged", "key: changed"),
            (action, "inputs.target_os == 'macos'", "inputs.target_os == 'linux'"),
            (batch, "dependency-security.yml", "another-security.yml"),
            (batch, "jobs:", "env:\n  RUSTFLAGS: changed\njobs:"),
        ):
            changed = {**current, path: current[path].replace(old, new)}
            with self.subTest(path=path, old=old), self.assertRaises(ValueError):
                verify(previous, changed)


if __name__ == "__main__":
    unittest.main()
