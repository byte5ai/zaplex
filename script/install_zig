#!/usr/bin/env bash

set -euo pipefail

ZIG_VERSION="0.13.0"
ZIG_ARCHIVE="zig-linux-x86_64-${ZIG_VERSION}.tar.xz"
ZIG_SHA256="d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea"
ZIG_URL="https://ziglang.org/download/${ZIG_VERSION}/${ZIG_ARCHIVE}"

if [[ -z "${GITHUB_PATH:-}" ]]; then
  echo "script/install_zig is intended for GitHub Actions" >&2
  exit 1
fi

install_root="$(mktemp -d)"
archive_path="${install_root}/${ZIG_ARCHIVE}"

curl --proto '=https' --tlsv1.2 -fsSL "$ZIG_URL" --output "$archive_path"
echo "$ZIG_SHA256  $archive_path" | sha256sum --check --strict -
tar -xJf "$archive_path" -C "$install_root"
echo "${install_root}/zig-linux-x86_64-${ZIG_VERSION}" >> "$GITHUB_PATH"
