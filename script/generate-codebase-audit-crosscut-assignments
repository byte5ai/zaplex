#!/usr/bin/env python3

"""Generate immutable assignments for the thirteen codebase-audit crosscuts.

Each crosscut is one model work item.  Its single invocation must apply all three
review lenses declared below; retrying that invocation is capped at three
attempts.  The three output buckets are scheduling partitions, not additional
model calls.  This preserves the finder contract from issue #245 while making
the invocation budget mechanically auditable.
"""

from __future__ import annotations

import argparse
import copy
import fnmatch
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import sys
import tempfile
from typing import Any


SCHEMA_VERSION = 1
GENERATOR_VERSION = 1
BUCKET_COUNT = 3
INVOCATIONS_PER_CROSSCUT = 1
MAX_ATTEMPTS_PER_INVOCATION = 3
LENSES = (
    "correctness-security",
    "failure-path-lifecycle",
    "regression-upstream",
)
EXPECTED_CROSSCUT_IDS = (
    "unsafe-app-and-zaplex",
    "unsafe-framework",
    "process-spawning",
    "terminal-model-lock",
    "async-blocking",
    "secrets-and-logging",
    "path-and-transfer-safety",
    "ssh-bootstrap-injection",
    "persistence-and-migrations",
    "ci-release-security",
    "upstream-drift",
    "error-swallowing-and-cancellation",
    "feature-flags-i18n-dead-code",
)
OBJECT_FORMAT_LENGTHS = {"sha1": 40, "sha256": 64}
SOURCE_TYPES = {"target-tree", "upstream-commit-series"}
OWNERSHIPS = {
    "fork-owned",
    "upstream-modified-by-fork",
    "upstream-unmodified",
}
MATCHER_FLAGS = {"dotall", "ignore-case", "multiline"}
