    {
      "context": {
        "after": 32,
        "before": 32
      },
      "description": "Review process creation for command-wrapper bypasses, shell injection, pipe deadlocks, missing waits, cancellation gaps, timeouts, and inherited secrets.",
      "id": "process-spawning",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "crates/command/src/*.rs"
        }
      ],
      "matchers": [
        {
          "flags": [],
          "id": "command-construction",
          "pattern": "(?:std|tokio)::process::Command|Command::new\\s*\\("
        },
        {
          "flags": [],
          "id": "process-execution",
          "pattern": "\\.(?:spawn|output|status|wait)\\s*\\("
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "shell-evaluation",
          "pattern": "(?:sh|bash|zsh)\\s+-[lc]|cmd(?:\\.exe)?\\s+/c|powershell(?:\\.exe)?.*-command|osascript|tmux\\s+send-keys"
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "app/**",
            "crates/**",
            "lib/**"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 40,
        "before": 40
      },
      "description": "Review TerminalModel and related shared-lock call chains for re-entrancy, lock-order inversion, callbacks or awaits under locks, and silently dropped try_lock work.",
      "id": "terminal-model-lock",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "app/src/terminal/model/mod.rs"
        }
      ],
      "matchers": [
        {
          "flags": [],
          "id": "lock-acquisition",
          "pattern": "(?:model\\s*\\.\\s*)?(?:try_)?lock\\s*\\(|\\.(?:read|write)\\s*\\("
        },
        {
          "flags": [],
          "id": "callbacks-and-await",
          "pattern": "\\.await\\b|ctx\\.(?:emit|notify|dispatch)\\s*\\(|callback\\s*\\("
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "app/src/**"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 32,
        "before": 32
      },
      "description": "Review synchronous filesystem, process, network, locking, waiting, and large parsing operations that can block async executors or UI-model threads.",
      "id": "async-blocking",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "app/src/lib.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "crates/warpui_core/src/lib.rs"
        }
      ],
      "matchers": [
        {
          "flags": [],
          "id": "blocking-api",
          "pattern": "std::fs::|std::thread::sleep|std::sync::(?:Mutex|RwLock)|block_on\\s*\\(|reqwest::blocking|\\.(?:wait|join|recv)\\s*\\("
        },
        {
          "flags": [],
          "id": "async-context",
          "pattern": "\\basync\\s+(?:fn|move)|\\.await\\b"
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "app/src/**",
            "crates/zaplex_*/**",
            "crates/zap_*/**",
            "crates/warp_ssh_manager/**",
            "crates/remote_server/**",
            "crates/http_client/**",
            "crates/warpui_core/**"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 36,
        "before": 36
      },
      "description": "Trace credentials and tokens through storage, logs, telemetry, crash reports, child environments, command lines, error surfaces, and exports.",
      "id": "secrets-and-logging",
      "mandatory_paths": [
