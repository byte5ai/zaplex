            "app/src/remote_server/**",
            "app/src/cockpit/**",
            "app/src/ssh_manager/**",
            "app/src/ai/subscription_agent/**",
            "app/src/workspace/view.rs"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 48,
        "before": 48
