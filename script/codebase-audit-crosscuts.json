    {
      "context": {
        "after": 40,
        "before": 40
      },
      "description": "Review feature-flag wiring, channel and Cargo configuration, Zaplex-owned dead code, and user-facing strings or catalog lookups that bypass or drift from Fluent resources.",
      "id": "feature-flags-i18n-dead-code",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "crates/warp_core/src/features.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/features.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/i18n.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/channels/*.desktop"
        },
