    {
      "context": {
        "after": 36,
        "before": 36
      },
      "description": "Review local and remote file operations for traversal, symlink and TOCTOU flaws, non-atomic promotion, cleanup, conflict races, permission loss, and offset arithmetic.",
      "id": "path-and-transfer-safety",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "crates/zap_sftp/src/**"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/workspace/view/server_file_browser.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/workspace/view.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/terminal/view/ssh_file_upload.rs"
        }
      ],
      "matchers": [
        {
          "flags": [
            "ignore-case"
          ],
          "id": "path-operation",
          "pattern": "canonicalize|symlink|read_link|rename|remove_(?:file|dir)|copy|temp(?:file|dir)?|PathBuf|\\.join\\s*\\("
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "transfer-operation",
          "pattern": "upload|download|transfer|overwrite|offset|resume|progress|cancel"
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "crates/zap_sftp/**",
            "crates/remote_server/**",
            "app/src/sftp_manager/**",
            "app/src/workspace/view/server_file_browser.rs",
            "app/src/workspace/view.rs",
            "app/src/terminal/view/ssh_file_upload.rs",
            "app/src/remote_server/**",
            "app/src/drive/**",
            "app/src/autoupdate/**"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 40,
        "before": 40
      },
      "description": "Trace SSH and bootstrap inputs into argv, remote shell strings, heredocs, tmux commands, host-key policy, and downloaded executable verification.",
      "id": "ssh-bootstrap-injection",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
