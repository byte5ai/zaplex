      "source_type": "target-tree"
    },
    {
      "context": {
        "after": 48,
        "before": 48
      },
      "description": "Adversarially review workflows, actions, hooks, and release scripts for untrusted interpolation, permissions, action pinning, secret exposure, signing bypass, tag errors, cache poisoning, and release races.",
      "id": "ci-release-security",
      "mandatory_paths": [
