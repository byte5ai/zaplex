          "id": "ssh-command",
          "pattern": "ssh|scp|sftp|ProxyCommand|LocalCommand|StrictHostKeyChecking|known_hosts|identity[_ -]?file|jump[_ -]?host"
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "remote-shell",
          "pattern": "heredoc|<<-?['\"]?[A-Za-z_]+|base64|printf|eval|tmux|curl[^\\n]*\\|[^\\n]*(?:sh|bash)|wget"
        }
      ],
      "path_rules": [
