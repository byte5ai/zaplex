        {
          "minimum_matches": 1,
          "pattern": "crates/managed_secrets/src/*.rs"
        },
        {
          "minimum_matches": 1,
          "pattern": "crates/warp_cli/**"
        },
        {
          "minimum_matches": 1,
          "pattern": "crates/zap_sync/**"
        },
        {
          "minimum_matches": 1,
          "pattern": "crates/warpui_extras/**"
        },
        {
          "minimum_matches": 1,
