            "crates/warp_cli/**",
            "crates/warpui_extras/**",
            ".github/workflows/*.yml",
            "script/macos/**"
          ]
        },
        {
          "action": "exclude",
          "patterns": [
            "**"
          ]
        }
      ],
      "source_type": "target-tree"
