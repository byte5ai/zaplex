      "description": "Review every unsafe Rust site in product and Zaplex-owned code for concrete aliasing, lifetime, FFI, ownership, and thread-safety violations.",
      "id": "unsafe-app-and-zaplex",
      "mandatory_paths": [
        {
          "minimum_matches": 1,
          "pattern": "crates/command/src/*.rs"
        }
      ],
      "matchers": [
        {
          "flags": [],
          "id": "unsafe-keyword",
          "pattern": "\\bunsafe\\b"
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "app/src/**",
            "crates/zaplex_*/**",
            "crates/zap_*/**",
            "crates/warp_ssh_manager/**",
            "crates/remote_server/**",
            "crates/command/**",
            "crates/managed_secrets*/**",
            "crates/prevent_sleep/**",
            "crates/node_runtime/**",
            "crates/computer_use/**",
            "crates/warp_terminal/**",
