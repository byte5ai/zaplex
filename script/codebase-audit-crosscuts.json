        },
        {
          "minimum_matches": 1,
          "pattern": "app/src/ai/subscription_agent/**"
        }
      ],
      "matchers": [
        {
          "flags": [],
          "id": "discarded-error",
          "pattern": "let\\s+_\\s*=|\\.ok\\s*\\(|if\\s+let\\s+Ok|unwrap_or_default\\s*\\(|map_err\\s*\\(\\s*\\|_\\|"
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "lifecycle-operation",
          "pattern": "spawn|JoinHandle|abort|cancel|timeout|interval|watcher|subscription|retry|backoff|kill_on_drop|drop\\s*\\("
