        },
        {
          "minimum_matches": 1,
          "pattern": "app/i18n/*.ftl"
        }
      ],
      "matchers": [
        {
          "flags": [
            "multiline"
          ],
          "id": "feature-flag",
          "pattern": "FeatureFlag::[A-Za-z0-9_]+|\\.is_enabled\\s*\\(|(?:RELEASE|PREVIEW|DOGFOOD)_FLAGS|cfg\\s*\\(\\s*feature|^\\[features\\]"
        },
        {
          "flags": [],
          "id": "hardcoded-ui-text",
          "pattern": "\\b(?:Text::(?:new|new_inline)|FormattedTextElement::from_str|Span::new)\\s*\\(\\s*(?:\"|r#*\")|\\bui_builder\\s*\\.\\s*label\\s*\\(\\s*(?:\"|r#*\")"
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "stub-or-dead-code",
          "pattern": "unimplemented!|todo!|not supported|coming soon|allow\\(dead_code\\)"
        },
        {
          "flags": [
            "ignore-case"
          ],
          "id": "i18n-surface",
          "pattern": "fluent|i18n|localiz|translate|tr!\\s*\\(|shared_string\\s*\\("
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
