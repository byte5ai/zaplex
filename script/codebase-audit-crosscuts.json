        },
        {
          "minimum_matches": 1,
          "pattern": "script/macos/bundle"
        }
      ],
      "matchers": [
        {
          "flags": [
            "ignore-case"
          ],
          "id": "credential-material",
          "pattern": "password|passphrase|private[_-]?key|api[_-]?key|access[_-]?token|refresh[_-]?token|secret|auth\\.json|CODEX_HOME|CLAUDE_CONFIG_DIR"
        },
        {
          "flags": [],
          "id": "logging-and-debug",
          "pattern": "(?:log|tracing)::(?:trace|debug|info|warn|error)!|#\\[derive\\([^]]*Debug|debug_dump|telemetry|crash_report"
        }
      ],
      "path_rules": [
        {
          "action": "include",
          "patterns": [
            "app/src/**",
            "crates/warp_ssh_manager/**",
            "crates/zaplex_cockpit/**",
            "crates/zaplex_remote_session/**",
            "crates/remote_server/**",
            "crates/managed_secrets*/**",
