      ],
      "matchers": [
        {
          "flags": [
            "ignore-case"
          ],
          "id": "workflow-trust-boundary",
          "pattern": "pull_request_target|workflow_run|github\\.event|head_ref|permissions:|secrets\\.|persist-credentials|cache|concurrency:"
        },
        {
          "flags": [
            "multiline"
          ],
          "id": "action-or-download",
          "pattern": "uses:\\s+[^\\s]+@[^\\s]+|curl[^\\n]*\\|[^\\n]*(?:sh|bash)|wget|notarytool|codesign|create_release|release-tag"
