      ],
      "matchers": [
        {
          "flags": [
            "ignore-case"
          ],
          "id": "schema-and-migration",
          "pattern": "create\\s+table|alter\\s+table|drop\\s+(?:table|column)|pragma\\s+foreign_keys|schema!|embed_migrations"
        },
        {
          "flags": [],
          "id": "database-operation",
          "pattern": "diesel::|rusqlite|\\.(?:execute|load|get_result)\\s*\\(|insert_into|sql_query|busy_timeout|journal_mode"
        }
      ],
      "path_rules": [
        {
          "action": "include",
