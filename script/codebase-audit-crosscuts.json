    {
      "context": {
        "after": 36,
        "before": 36
      },
      "description": "Review error-discarding constructs and task, watcher, child, PTY, retry, timeout, and drop lifecycles for false success, ghost work, leaks, and lost failures.",
      "id": "error-swallowing-and-cancellation",
      "mandatory_paths": [
