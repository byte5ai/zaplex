#!/usr/bin/env python3
"""Attribute executed functions to individual tests (#472).

Reads the manifest written by script/coverage-per-test-runner and the per-test
LLVM profiles (`pt-<key>-*.profraw`), merges each test's profiles with
llvm-profdata, and records which instrumented functions that test executed.
The result supports choosing tests whose functions are all executed by other
tests; the line-coverage limit itself is checked by a separate full run.

Units are mangled function names per instrumented binary. A function compiled
into several binaries is one unit, so the attribution errs towards keeping
tests.
"""
import argparse
import concurrent.futures
import gzip
import json
import os
import pathlib
import subprocess
import sys
import tempfile


def parse_text_profile(text):
    """Return the functions with a non-zero entry count in `llvm-profdata --text` output."""
    # A record is: name, "# Func Hash:", hash, "# Num Counters:", n,
    # "# Counter Values:", n values. Later LLVM versions may append further
    # sections (e.g. MC/DC bitmaps), so a record only starts where a name is
    # directly followed by "# Func Hash:".
    executed = set()
    lines = [line.strip() for line in text.splitlines()]
    for index in range(len(lines) - 6):
        if lines[index + 1] != "# Func Hash:" or lines[index + 3] != "# Num Counters:":
            continue
        if lines[index + 5] != "# Counter Values:":
            continue
        try:
            counters = int(lines[index + 4])
            first_value = int(lines[index + 6]) if counters else 0
        except ValueError:
            continue
        if first_value > 0:
            executed.add(lines[index])
    return executed


def executed_functions(llvm_profdata, profiles):
    with tempfile.TemporaryDirectory() as directory:
        merged = pathlib.Path(directory) / "merged.proftext"
        subprocess.run(
            [llvm_profdata, "merge", "--text", "--output", str(merged), *map(str, profiles)],
            check=True,
            capture_output=True,
            text=True,
        )
        return parse_text_profile(merged.read_text(encoding="utf-8", errors="replace"))


def read_manifest(path):
    tests = {}
    for line in pathlib.Path(path).read_text(encoding="utf-8").splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            key, binary, name = parts
            tests[key] = {"binary": binary, "name": name}
    return tests


def attribute(manifest, profile_root, llvm_profdata, jobs):
    tests = read_manifest(manifest)
    profiles = {}
    for profile in pathlib.Path(profile_root).rglob("pt-*.profraw"):
        key = profile.name[3:19]
        profiles.setdefault(key, []).append(profile)

    units = {}
    covered = {}
    failures = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = {
            pool.submit(executed_functions, llvm_profdata, files): key
            for key, files in profiles.items()
            if key in tests
        }
        for future in concurrent.futures.as_completed(futures):
            key = futures[future]
            try:
                functions = future.result()
            except subprocess.CalledProcessError as error:
                failures[key] = (error.stderr or "")[-400:]
                continue
            covered[key] = sorted(units.setdefault(name, len(units)) for name in functions)

    return {
        "schema_version": 1,
        "unit_kind": "llvm-function",
        "units": sorted(units, key=units.get),
        "tests": tests,
        "covered": covered,
        "without_profiles": sorted(set(tests) - set(profiles)),
        "failures": failures,
    }


def self_test():
    sample = "\n".join(
        [
            "# IR level Instrumentation Flag",
            ":fe",
            "_RNvCs1_4core3run",
            "# Func Hash:",
            "1234",
            "# Num Counters:",
            "2",
            "# Counter Values:",
            "3",
            "0",
            "# Num Bitmap Bytes:",
            "$1",
            "# Bitmap Byte Values:",
            "0x1",
            "",
            "_RNvCs1_4core4idle",
            "# Func Hash:",
            "99",
            "# Num Counters:",
            "1",
            "# Counter Values:",
            "0",
            "",
        ]
    )
    executed = parse_text_profile(sample)
    if executed != {"_RNvCs1_4core3run"}:
        print(f"per-test coverage self-test failed: {sorted(executed)}", file=sys.stderr)
        return 1
    print("per-test coverage self-test: ok")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--manifest")
    parser.add_argument("--profile-root")
    parser.add_argument("--llvm-profdata")
    parser.add_argument("--output")
    parser.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if not all([args.manifest, args.profile_root, args.llvm_profdata, args.output]):
        parser.error("--manifest, --profile-root, --llvm-profdata and --output are required")

    result = attribute(args.manifest, args.profile_root, args.llvm_profdata, args.jobs)
    with gzip.open(args.output, "wt", encoding="utf-8") as output:
        json.dump(result, output, separators=(",", ":"))
    print(
        f"attributed {len(result['covered'])} of {len(result['tests'])} tests to "
        f"{len(result['units'])} functions; {len(result['without_profiles'])} without "
        f"profiles, {len(result['failures'])} merge failures"
    )
    return 0 if result["covered"] else 1


if __name__ == "__main__":
    sys.exit(main())
