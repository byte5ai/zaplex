#!/usr/bin/env python3

"""Static regression checks for the dependency-security CI baseline."""

from pathlib import Path
import re
import sys


REPO_ROOT = Path(__file__).resolve().parent.parent
DENY_ACTION = "EmbarkStudios/cargo-deny-action@3c6349835b2b7b196a839186cb8b78e02f7b5f25"


def fail(message: str) -> None:
    print(f"dependency security baseline: {message}", file=sys.stderr)
    raise SystemExit(1)


def section(text: str, name: str) -> str:
    match = re.search(
        rf"(?ms)^\[{re.escape(name)}\]\s*$.*?(?=^\[[^[][^]]*\]\s*$|\Z)",
        text,
    )
    if match is None:
        fail(f"missing [{name}] section")
    return match.group(0)


def require_line(text: str, pattern: str, message: str) -> re.Match[str]:
    match = re.search(pattern, text, re.MULTILINE)
    if match is None:
        fail(message)
    return match


def string_array(text: str, key: str) -> set[str]:
    match = re.search(
        rf"(?ms)^\s*{re.escape(key)}\s*=\s*\[(.*?)^\s*\]",
        text,
    )
    if match is None:
        fail(f"missing {key} array")
    return set(re.findall(r'"([^"]+)"', match.group(1)))


def lock_packages(lock: str) -> list[dict[str, object]]:
    packages = []
    for block in re.split(r"(?m)^\[\[package\]\]\s*$", lock)[1:]:
        name = require_line(block, r'^name\s*=\s*"([^"]+)"', "lock package without name")
        version = require_line(
            block,
            r'^version\s*=\s*"([^"]+)"',
            f"lock package {name.group(1)} without version",
        )
        dependencies = re.search(r"(?ms)^dependencies\s*=\s*\[(.*?)^\]", block)
        packages.append(
            {
                "name": name.group(1),
                "version": version.group(1),
                "dependencies": dependencies.group(1) if dependencies is not None else "",
            }
        )
    return packages


def job_block(workflow: str, job_id: str) -> str:
    match = re.search(
        rf"(?ms)^  {re.escape(job_id)}:\s*$.*?(?=^  [A-Za-z0-9_-]+:\s*$|\Z)",
        workflow,
    )
    if match is None:
        fail(f"missing jobs.{job_id} in pr-check.yml")
    return match.group(0)


def version_tuple(version: str) -> tuple[int, ...]:
    numeric = version.split("+", 1)[0].split("-", 1)[0]
    return tuple(int(part) for part in numeric.split("."))


zap_sftp = (REPO_ROOT / "crates" / "zap_sftp" / "Cargo.toml").read_text()
zap_sync = (REPO_ROOT / "crates" / "zap_sync" / "Cargo.toml").read_text()
for crate_name, manifest in (("zap_sftp", zap_sftp), ("zap_sync", zap_sync)):
    package = section(manifest, "package")
    if re.search(r"(?m)^license\.workspace\s*=\s*true\s*$", package) is None:
        fail(f"{crate_name} must inherit workspace.package.license")
    if re.search(r"(?m)^publish\.workspace\s*=\s*true\s*$", package) is None:
        fail(f"{crate_name} must inherit workspace.package.publish")

openssl_version = require_line(
    section(zap_sftp, "dependencies"),
    r'^openssl-sys\s*=\s*\{[^\n}]*version\s*=\s*"([^"]+)"',
    "zap_sftp must declare openssl-sys with an explicit version",
).group(1)
if openssl_version == "*":
    fail("zap_sftp must not use a wildcard openssl-sys version")

deny = (REPO_ROOT / "deny.toml").read_text()
ignored = dict(
    re.findall(
        r'\{\s*id\s*=\s*"([^"]+)",\s*reason\s*=\s*"([^"]+)"\s*\}',
        section(deny, "advisories"),
    )
)
if "RUSTSEC-2023-0081" in ignored:
    fail("stale safemem advisory ignore must stay removed")
for advisory in ("RUSTSEC-2026-0192", "RUSTSEC-2026-0206"):
    if advisory not in ignored or "#243" not in ignored[advisory]:
        fail(f"temporary {advisory} ignore must carry its tracking reference")
if "pop-os/cosmic-text/issues/352" not in ignored["RUSTSEC-2026-0192"]:
    fail("the ttf-parser exception must link its upstream removal tracker")
if "pop-os/cosmic-text/pull/417" not in ignored["RUSTSEC-2026-0206"]:
    fail("the rustybuzz exception must link the upstream harfrust migration")
if not all(
    dependency in ignored["RUSTSEC-2026-0192"]
    for dependency in ("cosmic-text", "fontdb", "owned_ttf_parser", "rustybuzz")
):
    fail("the ttf-parser ignore must identify every remaining direct dependency path")
if "cosmic-text" not in ignored["RUSTSEC-2026-0206"]:
    fail("the rustybuzz ignore must identify its remaining direct dependency path")

allowed_git = string_array(section(deny, "sources"), "allow-git")
for repository in (
    "https://github.com/chenx-dust/winit.git",
    "https://github.com/zerx-lab/warp-proto-apis.git",
):
    if repository not in allowed_git:
        fail(f"missing exact source allowance for {repository}")

packages = lock_packages((REPO_ROOT / "Cargo.lock").read_text())
versions: dict[str, list[str]] = {}
for package in packages:
    versions.setdefault(str(package["name"]), []).append(str(package["version"]))

for name, minimum in {
    "anyhow": "1.0.103",
    "crossbeam-epoch": "0.9.20",
    "defmt": "1.1.1",
    "event-listener": "5.4.2",
    "git2": "0.21.0",
    "h2": "0.4.16",
    "libgit2-sys": "0.18.8",
    "quick-xml": "0.41.0",
    "rustls-webpki": "0.103.13",
    "spin": "0.10.1",
}.items():
    if name not in versions:
        fail(f"expected dependency {name} is absent from Cargo.lock")
    too_old = [version for version in versions[name] if version_tuple(version) < version_tuple(minimum)]
    if too_old:
        fail(f"{name} versions below {minimum}: {', '.join(too_old)}")

if "number_prefix" in versions:
    fail("unmaintained dependency number_prefix returned to Cargo.lock")

for package in packages:
    if package["name"] in ("proc-macro-error2", "proc-macro-error-attr2"):
        fail(f"unmaintained dependency {package['name']} returned to Cargo.lock")

for name, minimum in {"resvg": "0.48.1", "usvg": "0.48.1"}.items():
    if name not in versions:
        fail(f"expected font dependency {name} is absent from Cargo.lock")
    too_old = [version for version in versions[name] if version_tuple(version) < version_tuple(minimum)]
    if too_old:
        fail(f"{name} versions below {minimum}: {', '.join(too_old)}")

for package in packages:
    dependencies = str(package["dependencies"])
    if package["name"] in ("resvg", "usvg") and (
        '"rustybuzz"' in dependencies or '"ttf-parser"' in dependencies
    ):
        fail(f"{package['name']} returned to the unmaintained font stack")

expected_font_dependents = {
    "rustybuzz": {"cosmic-text"},
    "ttf-parser": {"cosmic-text", "fontdb", "owned_ttf_parser", "rustybuzz"},
}
for dependency_name, expected in expected_font_dependents.items():
    actual = {
        str(package["name"])
        for package in packages
        if any(
            dependency.split(" ", 1)[0] == dependency_name
            for dependency in re.findall(r'"([^"]+)"', str(package["dependencies"]))
        )
    }
    if actual != expected:
        fail(
            f"temporary {dependency_name} exception paths changed: "
            f"expected {sorted(expected)}, found {sorted(actual)}"
        )

i18n_embed_fl = next(package for package in packages if package["name"] == "i18n-embed-fl")
if version_tuple(str(i18n_embed_fl["version"])) < version_tuple("0.10.1"):
    fail("i18n-embed-fl must use the proc-macro-error3 migration")
if '"proc-macro-error2' in str(i18n_embed_fl["dependencies"]):
    fail("i18n-embed-fl returned to unmaintained proc-macro-error2")

legacy_versions = {
    "h2": "0.3.",
    "hyper": "0.14.",
    "hyper-rustls": "0.24.",
    "rustls": "0.21.",
    "rustls-webpki": "0.101.",
}
for name, prefix in legacy_versions.items():
    matches = [version for version in versions.get(name, []) if version.startswith(prefix)]
    if matches:
        fail(f"legacy {name} path returned: {', '.join(matches)}")

pr_workflow = (REPO_ROOT / ".github" / "workflows" / "pr-check.yml").read_text()
changes = job_block(pr_workflow, "changes")
cargo_check = job_block(pr_workflow, "cargo_check")
required_policy_checks = {
    "script/check_license_config_sync": "license configuration sync",
    "script/check-license-config-sync-tests": "license policy guard",
    "script/dependency-security-baseline-tests": "dependency security baseline",
}
for command, description in required_policy_checks.items():
    if command in changes:
        fail(f"the non-required changes job must not own the {description}")
    if command not in cargo_check:
        fail(f"the required cargo_check job must enforce the {description}")
if (
    DENY_ACTION not in cargo_check
    or "arguments: --all-features --locked" not in cargo_check
    or "command: check advisories bans licenses sources" not in cargo_check
):
    fail("the build-relevant cargo_check job must enforce the complete cargo-deny policy")
if "install_release_deps: true" not in cargo_check:
    fail("the dependency-policy job must install cargo-about")
if "cargo about generate --workspace --manifest-path Cargo.toml" not in cargo_check:
    fail("the dependency-policy job must generate third-party attribution")

keymap_smoke_test = job_block(pr_workflow, "keymap_smoke_test")
if "test_svg_text_rasterizes_with_loaded_system_fonts" not in keymap_smoke_test:
    fail("the required smoke job must rasterize SVG text with the migrated font stack")

scheduled = (REPO_ROOT / ".github" / "workflows" / "dependency-security.yml").read_text()
if "schedule:" not in scheduled or DENY_ACTION not in scheduled:
    fail("the scheduled workflow must enforce cargo-deny advisories")

print("dependency security baseline: ok")
