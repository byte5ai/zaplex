#!/usr/bin/env python3

"""Regression guard for the required build-relevant PR Clippy gate."""

from pathlib import Path
import re
import shlex
import os
import subprocess
import sys


REPO_ROOT = Path(__file__).resolve().parent.parent
WORKFLOW = REPO_ROOT / ".github" / "workflows" / "pr-check.yml"
REQUIRED_CONTEXT = "cargo check (Linux x86_64)"


def fail(message: str) -> None:
    print(f"pr-check Clippy gate: {message}", file=sys.stderr)
    raise SystemExit(1)


def job_block(lines: list[str], job_id: str) -> list[str]:
    start = next(
        (index for index, line in enumerate(lines) if line.rstrip() == f"  {job_id}:"),
        None,
    )
    if start is None:
        fail(f"missing jobs.{job_id}")

    end = next(
        (
            index
            for index in range(start + 1, len(lines))
            if re.match(r"^  [A-Za-z0-9_-]+:\s*$", lines[index])
        ),
        len(lines),
    )
    return lines[start:end]


def run_commands(job: list[str]) -> list[str]:
    commands = []
    index = 0
    while index < len(job):
        match = re.match(r"^(\s*)run:\s*(.*)$", job[index])
        if match is None:
            index += 1
            continue

        indent = len(match.group(1))
        value = match.group(2).strip()
        if value not in {"|", ">", "|-", ">-"}:
            commands.append(value)
            index += 1
            continue

        index += 1
        body = []
        while index < len(job):
            line = job[index]
            stripped = line.lstrip()
            if stripped and len(line) - len(stripped) <= indent:
                break
            if stripped and not stripped.startswith("#"):
                body.append(stripped.strip())
            index += 1
        commands.append(" ".join(body))

    return commands


def is_enforced_clippy(command: str) -> bool:
    try:
        args = shlex.split(command)
    except ValueError:
        return False

    if args[:2] != ["cargo", "clippy"] or "--locked" not in args:
        return False
    if "--bin" not in args or args.index("--bin") + 1 >= len(args):
        return False
    if args[args.index("--bin") + 1] != "zaplex" or "--" not in args:
        return False

    lint_args = args[args.index("--") + 1 :]
    return any(
        lint_args[index : index + 2] == ["-D", "warnings"]
        for index in range(len(lint_args) - 1)
    )


workflow_lines = WORKFLOW.read_text(encoding="utf-8").splitlines()
cargo_job = job_block(workflow_lines, "cargo_check")
cargo_job_text = "\n".join(cargo_job)

if f"name: {REQUIRED_CONTEXT}" not in cargo_job_text:
    fail(f"jobs.cargo_check must keep required context {REQUIRED_CONTEXT!r}")
if "needs: changes" not in cargo_job_text:
    fail("jobs.cargo_check must depend on the build-relevance detector")
required_condition = "if: always() && (needs.changes.result != 'success' || needs.changes.outputs.needs_build != 'false')"
if required_condition not in cargo_job_text:
    fail("jobs.cargo_check must fail closed unless changes successfully declares docs-only")

# Execute the actual first-step guard with dependency outcomes; never invoke Cargo.
step_start = next((i for i, line in enumerate(cargo_job)
                   if line.strip() == "- name: Require successful change detection"), None)
if step_start is None:
    fail("required job is missing its change-detection guard")
if any(line.lstrip().startswith("- ") for line in cargo_job[:step_start]):
    fail("change-detection guard must precede checkout and compilation")
step_end = next((i for i in range(step_start + 1, len(cargo_job))
                 if cargo_job[i].startswith("      - ")), len(cargo_job))
guard_step = cargo_job[step_start:step_end]
if "CHANGES_RESULT: ${{ needs.changes.result }}" not in "\n".join(guard_step):
    fail("guard must use the real dependency result")
if "NEEDS_BUILD: ${{ needs.changes.outputs.needs_build }}" not in "\n".join(guard_step):
    fail("guard must use the real build-relevance output")
run_start = next((i for i, line in enumerate(guard_step) if line.strip() == "run: |"), None)
if run_start is None:
    fail("guard must have a literal shell body")
body = "\n".join(line[10:] for line in guard_step[run_start + 1:])
nonrust_case = __import__("runpy").run_path(str(Path(__file__).with_name("test-suite-nonrust-events")))["record"]

for result, output, expected_success in [
    ("success", "true", True),
    ("success", "", False),
    ("success", "invalid", False),
    ("failure", "true", False),
    ("failure", "false", False),
    ("cancelled", "true", False),
    ("skipped", "", False),
]:
    completed = subprocess.run(
        ["bash", "-c", body],
        env={**os.environ, "CHANGES_RESULT": result, "NEEDS_BUILD": output},
        capture_output=True, text=True, timeout=5,
    )
    if (completed.returncode == 0) != expected_success:
        fail(f"change-detection guard mishandled {result=}, {output=}")
    nonrust_case(f"change-detection:{result}:{output}")
if not any(is_enforced_clippy(command) for command in run_commands(cargo_job)):
    fail("jobs.cargo_check must run cargo clippy --locked --bin zaplex -- -D warnings")

print("pr-check Clippy gate: ok")
