#!/usr/bin/env python3

"""Regression guard for the required build-relevant PR Clippy gate."""

from pathlib import Path
import re
import shlex
import sys


REPO_ROOT = Path(__file__).resolve().parent.parent
WORKFLOW = REPO_ROOT / ".github" / "workflows" / "pr-check.yml"
REQUIRED_CONTEXT = "cargo check (Linux x86_64)"


def fail(message: str) -> None:
    print(f"pr-check Clippy gate: {message}", file=sys.stderr)
    raise SystemExit(1)


def job_block(lines: list[str], job_id: str) -> list[str]:
    start = next(
        (index for index, line in enumerate(lines) if line.rstrip() == f"  {job_id}:"),
        None,
    )
    if start is None:
        fail(f"missing jobs.{job_id}")

    end = next(
        (
            index
            for index in range(start + 1, len(lines))
            if re.match(r"^  [A-Za-z0-9_-]+:\s*$", lines[index])
        ),
        len(lines),
    )
    return lines[start:end]


def run_commands(job: list[str]) -> list[str]:
    commands = []
    index = 0
    while index < len(job):
        match = re.match(r"^(\s*)run:\s*(.*)$", job[index])
        if match is None:
            index += 1
            continue

        indent = len(match.group(1))
        value = match.group(2).strip()
        if value not in {"|", ">", "|-", ">-"}:
            commands.append(value)
            index += 1
            continue

        index += 1
        body = []
        while index < len(job):
            line = job[index]
            stripped = line.lstrip()
            if stripped and len(line) - len(stripped) <= indent:
                break
            if stripped and not stripped.startswith("#"):
                body.append(stripped.strip())
            index += 1
        commands.append(" ".join(body))

    return commands


def is_enforced_clippy(command: str) -> bool:
    try:
        args = shlex.split(command)
    except ValueError:
        return False

    if args[:2] != ["cargo", "clippy"] or "--locked" not in args:
        return False
    if "--bin" not in args or args.index("--bin") + 1 >= len(args):
        return False
    if args[args.index("--bin") + 1] != "zaplex" or "--" not in args:
        return False

    lint_args = args[args.index("--") + 1 :]
    return any(
        lint_args[index : index + 2] == ["-D", "warnings"]
        for index in range(len(lint_args) - 1)
    )


workflow_lines = WORKFLOW.read_text(encoding="utf-8").splitlines()
cargo_job = job_block(workflow_lines, "cargo_check")
cargo_job_text = "\n".join(cargo_job)

if f"name: {REQUIRED_CONTEXT}" not in cargo_job_text:
    fail(f"jobs.cargo_check must keep required context {REQUIRED_CONTEXT!r}")
if "needs: changes" not in cargo_job_text:
    fail("jobs.cargo_check must depend on the build-relevance detector")
if "if: needs.changes.outputs.needs_build == 'true'" not in cargo_job_text:
    fail("jobs.cargo_check must keep the needs_build gate")
if not any(is_enforced_clippy(command) for command in run_commands(cargo_job)):
    fail("jobs.cargo_check must run cargo clippy --locked --bin zaplex -- -D warnings")

print("pr-check Clippy gate: ok")
