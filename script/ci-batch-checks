#!/usr/bin/env python3
"""Verify a completed checks-only batch before building artifacts later."""

import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys

helpers = runpy.run_path(str(Path(__file__).with_name("ci-batch-resume")))
REPO = helpers["REPO"]
GATES = helpers["PASSED_JOBS"] | {"tests / cargo test (macOS)"}


def validate(run, jobs, source):
    if not re.fullmatch(r"[a-f0-9]{40}", source):
        raise ValueError("Invalid source SHA")
    expected = dict(status="completed", conclusion="success", event="workflow_dispatch",
                    head_branch="main", path=".github/workflows/ci-batch.yml", head_sha=source)
    if (any(run.get(key) != value for key, value in expected.items())
            or run.get("head_repository", {}).get("full_name") != REPO):
        raise ValueError("Checks must be a successful main batch at this exact commit")
    by_name = {job["name"]: job for job in jobs}
    if len(by_name) != len(jobs):
        raise ValueError("Ambiguous check jobs")
    for name in GATES | {"Validate main batch", "Verify all selected batch stages"}:
        if by_name.get(name, {}).get("conclusion") != "success":
            raise ValueError(f"Missing successful check: {name}")
    for name in ("test_dmg", "remote_server"):
        if by_name.get(name, {}).get("conclusion") != "skipped":
            raise ValueError("Only checks-only batches may be continued")
    if any(job.get("conclusion") not in ("success", "skipped") for job in jobs):
        raise ValueError("Unsuccessful check job")
    if any(name.startswith(("test_dmg /", "remote_server /")) for name in by_name):
        raise ValueError("Artifact stages already executed")
    steps = {s["name"]: s.get("conclusion") for s in by_name["tests / cargo test (macOS)"].get("steps", [])}
    for name, expected in (("Isolated package tests", "success"),
                           ("Package documentation tests", "success"),
                           ("Rust workspace coverage tests", "skipped")):
        if steps.get(name, "skipped" if name == "Rust workspace coverage tests" else None) != expected:
            raise ValueError(f"Unexpected test scope: {name}")


def read(run_id, source):
    if not re.fullmatch(r"[1-9][0-9]*", run_id):
        raise ValueError("Numeric checks run ID required")
    run, jobs, _ = helpers["read_run"](run_id)
    validate(run, jobs, source)
    return jobs


def restore(run, jobs, artifacts, load_receipt, read_checks=read):
    """Resolve inherited gates independently for later artifact/release validators."""
    proofs = [item for item in artifacts if item["name"] == "ci-checks-provenance"]
    if not proofs:
        return jobs
    if len(proofs) != 1 or proofs[0].get("expired") is not False:
        raise ValueError("Missing or ambiguous checks provenance")
    by_name = {job["name"]: job for job in jobs}
    if len(by_name) != len(jobs) or by_name.get("Validate main batch", {}).get("conclusion") != "success":
        raise ValueError("Checks provenance requires a successful preflight")
    for name in ("dependency_security", "compile_checks", "tests", "live_sftp"):
        if by_name.get(name, {}).get("conclusion") != "skipped":
            raise ValueError("Unexpected inherited gate status")
    receipt = load_receipt()
    if receipt.get("source_sha") != run.get("head_sha"):
        raise ValueError("Checks provenance differs from artifact source")
    original = read_checks(receipt["checks_run_id"], receipt["source_sha"])
    if any(job["name"] in GATES for job in jobs):
        raise ValueError("Duplicate original and inherited gates")
    return jobs + [job for job in original if job["name"] in GATES]


def main():
    run_id = os.environ.get("CHECKS_RUN_ID", "")
    if not run_id:
        return
    if (os.environ.get("GITHUB_REPOSITORY") != REPO
            or os.environ.get("GITHUB_REF") != "refs/heads/main"
            or os.environ.get("COVERAGE") != "false"
            or os.environ.get("PER_TEST_COVERAGE") != "false"
            or os.environ.get("RESUME_RUN_ID") or os.environ.get("RESUME_BASE_RUN_ID")
            or os.environ.get("ARTIFACTS") not in ("test-dmg", "remote-server")):
        raise ValueError("Checks reuse requires artifacts only, without other resume/coverage modes")
    source = os.environ["GITHUB_SHA"]
    read(run_id, source)
    Path("ci-checks-provenance.json").write_text(json.dumps({"checks_run_id": run_id, "source_sha": source}) + "\n")
    with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
        output.write("reuse_all_checks=true\n")
    with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a") as summary:
        summary.write(f"Artifact stages only; all checks verified from https://github.com/{REPO}/actions/runs/{run_id} at `{source}`.\n")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f"Checks reuse refused: {error}", file=sys.stderr)
        sys.exit(1)
