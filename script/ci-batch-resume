#!/usr/bin/env python3
"""Reuse proven CI gates after runner failures, never after app changes."""

import json
import hashlib
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile


REPO = "byte5ai/zaplex"
PASSED_JOBS = {
    "dependency_security / cargo deny check advisories",
    "compile_checks / detect build-relevant changes",
    "compile_checks / cargo policy (macOS Apple Silicon)",
    "compile_checks / cargo check (macOS Apple Silicon)",
    "compile_checks / app regressions (macOS Apple Silicon)",
    "live_sftp / OpenSSH/SFTP commit-boundary recovery",
    "tests / Linux daemon regressions",
}
# These paths do not feed the passed compile, SFTP or documentation-test commands.
RESUME_PATHS = {
    ".github/workflows/ci-batch.yml",
    ".github/workflows/test-dispatch.yml",
    "script/run-shell-ssh-fixtures",
    "script/shell-ssh-runner-guard-tests",
    "script/ci-batch-resume",
    "script/ci-batch-resume-tests",
    "docs/ci-batch.md",
}
MACOS_RESUME_PATHS = {
    ".github/workflows/ci-batch.yml",
    ".github/workflows/pr-check.yml",
    "script/ci-batch-resume",
    "script/ci-batch-resume-tests",
    "docs/ci-batch.md",
}
MACOS_GATE = "compile_checks / cargo check (macOS Apple Silicon)"
EARLY_NATIVE_GATES = PASSED_JOBS - {MACOS_GATE, "compile_checks / app regressions (macOS Apple Silicon)",
                            "live_sftp / OpenSSH/SFTP commit-boundary recovery",
                            "tests / Linux daemon regressions"}
LINUX_INPUT = """    inputs:
      reuse_linux_checks:
        description: Reuse earlier native policy gates validated by the batch preflight
        type: boolean
        default: false
"""
TAIL_RESUME_PATHS = {
    ".github/workflows/ci-batch.yml", "script/ci-batch-resume",
    "script/ci-batch-resume-tests", "script/ci-batch-completion",
    "script/ci-batch-scheduling-tests", "docs/ci-batch.md",
}

PRE_POLICY_PATHS = {
    ".github/workflows/pr-check.yml", ".github/workflows/ci-batch.yml",
    ".github/actions/prepare-native-checks/action.yml", "script/prepare-native-checks",
    "script/ci-batch-resume", "script/ci-batch-resume-tests",
    "script/ci-batch-completion", "script/ci-batch-scheduling-tests",
    "script/ci-batch-checks", "script/ci-batch-checks-tests", "script/pr-check-clippy-gate-tests",
    "script/test-suite-nonrust-plan.json", "docs/ci-batch.md",
}
PRE_POLICY_GATES = {"dependency_security / cargo deny check advisories",
                    "compile_checks / detect build-relevant changes"}


def validate_pre_policy_inputs(previous, current):
    def detector(text):
        match = re.search(r"(?ms)^  changes:\n.*?(?=^  \w+:|\Z)", text)
        if match is None:
            raise ValueError("Missing static check job")
        return match.group().replace("    if: ${{ !inputs.reuse_static_checks }}\n", "")
    if detector(previous) != detector(current):
        raise ValueError("Passed static check commands or environment changed")
    def environment(text):
        match = re.search(r"(?ms)^env:\n.*?(?=^jobs:)", text)
        return match.group() if match else ""
    if environment(previous) != environment(current):
        raise ValueError("Passed static check global environment changed")


def validate_pre_policy_plan(previous, current, old_workflow, new_workflow):
    for plan, workflow in ((previous, old_workflow), (current, new_workflow)):
        expected = hashlib.sha256(workflow.encode()).hexdigest()
        if plan["inventory_source_hashes"].get(".github/workflows/pr-check.yml") != expected:
            raise ValueError("Static inventory workflow fingerprint differs")
    old, new = json.loads(json.dumps(previous)), json.loads(json.dumps(current))
    for plan in (old, new):
        plan["inventory_source_hashes"].pop(".github/workflows/pr-check.yml")
    if old != new:
        raise ValueError("Passed non-Rust test inventory changed")


def restore_pre_policy(run, jobs, artifacts):
    proofs = [a for a in artifacts if a["name"] == "ci-pre-policy-provenance"]
    if not proofs:
        return jobs
    if (len(proofs) != 1 or proofs[0].get("expired") is not False
            or run.get("head_branch") != "main" or run.get("event") != "workflow_dispatch"
            or run.get("status") != "completed" or run.get("conclusion") not in ("success", "failure")
            or run.get("head_repository", {}).get("full_name") != REPO):
        raise ValueError("Invalid pre-policy provenance context")
    with tempfile.TemporaryDirectory(prefix="zaplex-pre-policy-") as directory:
        command("gh", "run", "download", str(run["id"]), "--repo", REPO,
                "--name", "ci-pre-policy-provenance", "--dir", directory)
        receipt = json.loads((Path(directory) / "ci-pre-policy-provenance.json").read_text())
    if receipt.get("qualified_sha") != run.get("head_sha"):
        raise ValueError("Pre-policy provenance source mismatch")
    original, original_jobs, source = read_run(str(receipt["run_id"]))
    if source != receipt.get("source_sha"):
        raise ValueError("Pre-policy origin changed")
    changed = command("git", "diff", "--name-only", source, run["head_sha"]).splitlines()
    if validate(original, original_jobs, changed) != "pre-policy":
        raise ValueError("Origin does not prove the pre-policy gates")
    workflow = ".github/workflows/pr-check.yml"
    validate_pre_policy_inputs(command("git", "show", f"{source}:{workflow}"),
                              command("git", "show", f"{run['head_sha']}:{workflow}"))
    plan = "script/test-suite-nonrust-plan.json"
    validate_pre_policy_plan(
        json.loads(command("git", "show", f"{source}:{plan}")),
        json.loads(command("git", "show", f"{run['head_sha']}:{plan}")),
        command("git", "show", f"{source}:{workflow}"),
        command("git", "show", f"{run['head_sha']}:{workflow}"),
    )
    by_name = {j["name"]: j for j in jobs}
    if len(by_name) != len(jobs) or by_name.get("Validate main batch", {}).get("conclusion") != "success":
        raise ValueError("Pre-policy reuse requires successful qualification")
    if by_name.get("dependency_security", {}).get("conclusion") != "skipped":
        raise ValueError("Expected explicitly inherited dependency gate")
    static = "compile_checks / detect build-relevant changes"
    if by_name.get(static, {}).get("conclusion") != "skipped":
        raise ValueError("Expected explicitly inherited static gate")
    restored = [j for j in jobs if j["name"] != static]
    restored.extend(j for j in original_jobs if j["name"] in PRE_POLICY_GATES)
    if len({j["name"] for j in restored}) != len(restored):
        raise ValueError("Duplicate restored pre-policy gate")
    return restored


def validate_tail(run, jobs, changed_paths):
    # A scheduling defect can leave a green run without executing its tail.
    if (run.get("status") != "completed" or run.get("conclusion") not in ("success", "failure")
            or run.get("event") != "workflow_dispatch" or run.get("head_branch") != "main"
            or run.get("path") != ".github/workflows/ci-batch.yml"
            or run.get("head_repository", {}).get("full_name") != REPO):
        raise ValueError("Tail resume requires a completed main batch from this repository")
    by_name = {job["name"]: job for job in jobs}
    if len(by_name) != len(jobs):
        raise ValueError("Ambiguous duplicate job names")
    for name in ("Validate main batch", "compile_checks / detect build-relevant changes",
                 MACOS_GATE, "tests / cargo test (macOS)"):
        if by_name.get(name, {}).get("conclusion") != "success":
            raise ValueError(f"Missing successful tail prerequisite: {name}")
    for name in ("dependency_security", "compile_checks / cargo policy (macOS Apple Silicon)",
                 "compile_checks / app regressions (macOS Apple Silicon)", "live_sftp"):
        if by_name.get(name, {}).get("conclusion") != "skipped":
            raise ValueError(f"Unexpected tail source gate: {name}")
    steps = {step["name"]: step.get("conclusion")
             for step in by_name["tests / cargo test (macOS)"].get("steps", [])}
    if (steps.get("Isolated package tests") != "success"
            or steps.get("Package documentation tests") != "success"
            or steps.get("Rust workspace coverage tests", "skipped") != "skipped"):
        raise ValueError("Tail resume requires successful package/doc tests without coverage")
    for name, job in by_name.items():
        if name.startswith(("live_sftp /", "test_dmg", "remote_server")):
            if job.get("conclusion") != "skipped":
                raise ValueError(f"Tail stage already executed: {name}")
    if any(path not in TAIL_RESUME_PATHS for path in changed_paths):
        raise ValueError("Passed compile/test inputs changed since the tail source")


def validate(run, jobs, changed_paths):
    if (
        run.get("status") != "completed"
        or run.get("conclusion") != "failure"
        or run.get("event") != "workflow_dispatch"
        or run.get("head_branch") != "main"
        or run.get("path") != ".github/workflows/ci-batch.yml"
        or run.get("head_repository", {}).get("full_name") != REPO
    ):
        raise ValueError("Resume requires a completed failed main batch from this repository")
    by_name = {job["name"]: job for job in jobs}
    if len(by_name) != len(jobs):
        raise ValueError("Ambiguous duplicate job names")
    if (by_name.get("compile_checks / app regressions (macOS Apple Silicon)", {}).get("conclusion") == "failure"
            and by_name.get(MACOS_GATE, {}).get("conclusion") == "success"):
        native = runpy.run_path(str(Path(__file__).with_name("ci-native-checks-resume")))
        native["validate_run"](run, jobs, changed_paths)
        return "regressions"
    policy = "compile_checks / cargo policy (macOS Apple Silicon)"
    if (by_name.get(policy, {}).get("conclusion") == "failure"
            and by_name.get(MACOS_GATE, {}).get("conclusion") == "skipped"):
        for name in PRE_POLICY_GATES:
            gate = by_name.get(name, {})
            if gate.get("conclusion") != "success" or gate.get("labels") != ["macrunner"]:
                raise ValueError("Pre-policy reuse needs proven native security/static gates")
        for name, job in by_name.items():
            if (name.startswith(("tests /", "live_sftp /", "test_dmg /", "remote_server /"))
                    or name == "compile_checks / app regressions (macOS Apple Silicon)"):
                if job.get("conclusion") != "skipped":
                    raise ValueError("Downstream checks already executed")
        if any(path not in PRE_POLICY_PATHS for path in changed_paths):
            raise ValueError("Passed pre-policy gate inputs changed")
        return "pre-policy"
    if by_name.get(MACOS_GATE, {}).get("conclusion") == "failure":
        for name in sorted(EARLY_NATIVE_GATES):
            if by_name.get(name, {}).get("conclusion") != "success":
                raise ValueError(f"Cannot reuse missing or unsuccessful gate: {name}")
        # The following stages must not have executed: they run for the first time.
        for name, job in by_name.items():
            if (name.startswith(("tests /", "live_sftp /", "test_dmg /", "remote_server /"))
                    or name == "compile_checks / app regressions (macOS Apple Silicon)"):
                if job.get("conclusion") != "skipped":
                    raise ValueError(f"Downstream stage already executed: {name}")
        if any(path not in MACOS_RESUME_PATHS for path in changed_paths):
            raise ValueError("Passed native policy/security gate inputs changed")
        return "linux"
    for name in sorted(PASSED_JOBS):
        if by_name.get(name, {}).get("conclusion") != "success":
            raise ValueError(f"Cannot reuse missing or unsuccessful gate: {name}")
    tests = by_name.get("tests / cargo test (macOS)", {})
    steps = {step["name"]: step.get("conclusion") for step in tests.get("steps", [])}
    if (
        tests.get("conclusion") != "failure"
        or steps.get("Isolated package tests") != "failure"
        or steps.get("Package documentation tests") != "success"
        or steps.get("Rust workspace coverage tests", "skipped") != "skipped"
    ):
        raise ValueError("Resume supports a failed package test with passed doc tests only")
    unsafe = [
        path for path in changed_paths
        if path not in RESUME_PATHS and not path.startswith("specs/GH-564/")
    ]
    if unsafe:
        raise ValueError(f"Passed-gate inputs changed; a new batch is needed: {unsafe}")
    return "package"


def validate_linux_inputs(previous, current, *, include_tests=False):
    workflow = ".github/workflows/pr-check.yml"
    def normalize_compile(text):
        text = text.replace(LINUX_INPUT, "")
        # These later native jobs had not executed when the compile gate failed.
        for job in ("cargo_check_macos", "keymap_smoke_test"):
            text = re.sub(rf"(?ms)^  {job}:\n.*?(?=^  \w+:|\Z)", "", text)
        for job in ("cargo_check",):
            text = re.sub(
                rf"(?ms)^  {job}:\n.*?(?=^  \w+:|\Z)",
                lambda block: re.sub(
                    r"(?m)^(    if: .*)$",
                    lambda match: match.group().replace("!inputs.reuse_linux_checks && ", "")
                    .replace(" && !inputs.reuse_linux_checks", ""), block.group(),
                ), text,
            )
        return text
    if normalize_compile(previous[workflow]) != normalize_compile(current[workflow]):
        raise ValueError("Earlier native dependency-policy inputs changed")

    action = ".github/actions/prepare_environment/action.yml"
    if previous[action] != current[action]:
        raise ValueError("Passed native dependency-policy environment changed")

    batch = ".github/workflows/ci-batch.yml"
    for text in (previous[batch], current[batch]):
        if re.search(r"(?m)^env:", text):
            raise ValueError("Batch environment must remain unset")
    for job in ("dependency_security", "compile_checks") + (("tests",) if include_tests else ()):
        def block(text):
            match = re.search(rf"(?ms)^  {job}:\n.*?(?=^  \w+:|\Z)", text)
            if match is None:
                raise ValueError(f"Missing batch job: {job}")
            return re.sub(r"(?m)^    if:.*\n(?:^      .*\n)*", "", match.group()).replace(
                "    with:\n      reuse_linux_checks: ${{ needs.preflight.outputs.reuse_linux_checks == 'true' }}\n", ""
            )
        if block(previous[batch]) != block(current[batch]):
            raise ValueError(f"Passed batch job inputs changed: {job}")


def command(*args):
    return subprocess.check_output(args, text=True, timeout=60)


def read_run(run_id):
    if not run_id.isdecimal():
        raise ValueError("Invalid source run ID")
    run = json.loads(command("gh", "api", f"repos/{REPO}/actions/runs/{run_id}"))
    pages = json.loads(command(
        "gh", "api", "--paginate", "--slurp",
        f"repos/{REPO}/actions/runs/{run_id}/jobs?per_page=100",
    ))
    source = run["head_sha"]
    if len(source) != 40 or any(c not in "0123456789abcdef" for c in source):
        raise ValueError("Invalid source SHA")
    command("git", "fetch", "--no-tags", "--depth=1", "origin", source)
    return run, [job for page in pages for job in page["jobs"]], source


def validate_test_inputs(previous, current):
    # The skipped doc tests must retain their package, feature environment and
    # command. Runner selection and the new skip condition are not build inputs.
    patterns = [r"(?ms)^env:\n.*?(?=^jobs:)"]
    for name in ("package", "filter", "coverage", "per_test_coverage"):
        patterns.append(rf"(?ms)^      {name}:\n.*?(?=^      \w+:|^permissions:)")
    for name in ("Isolated package tests", "Package documentation tests"):
        patterns.append(rf"(?ms)^      - name: {name}\n.*?(?=^      - name:|\Z)")
    for pattern in patterns:
        old = re.search(pattern, previous)
        new = re.search(pattern, current)
        if old is None or new is None:
            raise ValueError("Missing package/doc-test input block")
        # Only the documentation-test scheduling condition changes on resume.
        normalize = lambda text: re.sub(r"(?m)^        if:.*\n", "", text).strip()
        if normalize(old.group()) != normalize(new.group()):
            raise ValueError("Package/doc-test inputs changed")
    prefix = r"(?ms)^  test:\n.*?(?=^    steps:)"
    old = re.search(prefix, previous).group()
    new = re.search(prefix, current).group()
    new = new.replace(
        "    env:\n      ZAPLEX_TEST_RUNNER_LABEL: ${{ inputs.runs_on }}\n", ""
    )
    old = old.replace(
        "    env:\n      ZAPLEX_TEST_RUNNER_LABEL: ${{ inputs.runs_on }}\n", ""
    )
    if old != new:
        raise ValueError("Test job environment changed")


def main():
    run_id = os.environ.get("RESUME_RUN_ID", "")
    base_id = os.environ.get("RESUME_BASE_RUN_ID", "")
    if not run_id:
        if base_id:
            raise ValueError("A prerequisite run requires a primary resume run")
        return
    if not run_id.isdecimal() or os.environ.get("GITHUB_REPOSITORY") != REPO:
        raise ValueError("Invalid resume run or repository")
    if os.environ.get("COVERAGE") != "false":
        raise ValueError("Coverage batches cannot reuse package-test gates")
    run, jobs, source = read_run(run_id)
    changed = command("git", "diff", "--name-only", source, "HEAD").splitlines()
    extra_evidence = ""
    if base_id:
        validate_tail(run, jobs, changed)
        base_run, base_jobs, base_source = read_run(base_id)
        inherited_changes = command("git", "diff", "--name-only", base_source, source).splitlines()
        if validate(base_run, base_jobs, inherited_changes) != "linux":
            raise ValueError("Tail prerequisite must prove the inherited Linux/security gates")
        paths = (".github/workflows/pr-check.yml", ".github/workflows/ci-batch.yml",
                 ".github/actions/prepare_environment/action.yml")
        validate_linux_inputs(
            {path: command("git", "show", f"{base_source}:{path}") for path in paths},
            {path: command("git", "show", f"{source}:{path}") for path in paths},
        )
        validate_linux_inputs(
            {path: command("git", "show", f"{source}:{path}") for path in paths},
            {path: Path(path).read_text() for path in paths}, include_tests=True,
        )
        output_name = "reuse_pre_sftp_checks"
        evidence = "macOS compile/native and package/doc-test"
        remaining = "live SFTP and the previously unexecuted artifact stages"
        extra_evidence = (
            f" Inherited Linux/security gates independently verified from "
            f"[run {base_id}](https://github.com/{REPO}/actions/runs/{base_id}) at `{base_source}`."
        )
        mode = "tail"
    else:
        mode = validate(run, jobs, changed)
    if mode == "regressions":
        native = runpy.run_path(str(Path(__file__).with_name("ci-native-checks-resume")))
        paths = (native["WORKFLOW"], native["PLAN"])
        passed = native["validate_inputs"](
            {path: command("git", "show", f"{source}:{path}") for path in paths},
            {path: Path(path).read_text() for path in paths}, jobs, validate_pre_policy_plan,
        )
        counts = native["read_test_counts"](run_id, jobs)
        native["validate_test_counts"](passed, counts)
        Path("ci-native-checks-provenance.json").write_text(json.dumps({
            "run_id": run_id, "source_sha": source, "qualified_sha": os.environ["GITHUB_SHA"],
            "passed_regression_steps": passed, "passed_test_counts": counts,
        }) + "\n")
        with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
            output.write(f"passed_regression_steps={json.dumps(passed)}\n")
        output_name = "reuse_native_checks"
        evidence = "native security/static/policy/compile and unchanged successful regression-step"
        remaining = "failed/unexecuted regressions, Linux-only minidumps and downstream stages"
    elif mode == "pre-policy":
        workflow = ".github/workflows/pr-check.yml"
        validate_pre_policy_inputs(command("git", "show", f"{source}:{workflow}"), Path(workflow).read_text())
        plan = "script/test-suite-nonrust-plan.json"
        validate_pre_policy_plan(json.loads(command("git", "show", f"{source}:{plan}")),
            json.loads(Path(plan).read_text()), command("git", "show", f"{source}:{workflow}"),
            Path(workflow).read_text())
        Path("ci-pre-policy-provenance.json").write_text(json.dumps({
            "run_id": run_id, "source_sha": source, "qualified_sha": os.environ["GITHUB_SHA"],
        }) + "\n")
        output_name = "reuse_pre_policy_checks"
        evidence = "native dependency-security and static"
        remaining = "native policy/compile/tests and previously unexecuted artifacts"
    elif mode == "linux":
        paths = (".github/workflows/pr-check.yml", ".github/workflows/ci-batch.yml",
                 ".github/actions/prepare_environment/action.yml")
        validate_linux_inputs(
            {path: command("git", "show", f"{source}:{path}") for path in paths},
            {path: Path(path).read_text() for path in paths},
        )
        output_name = "reuse_linux_checks"
        evidence = "dependency-security and native dependency/Clippy policy"
        remaining = "macOS checks and the previously unexecuted downstream stages"
    elif mode == "package":
        workflow = ".github/workflows/test-dispatch.yml"
        validate_test_inputs(command("git", "show", f"{source}:{workflow}"), Path(workflow).read_text())
        output_name = "reuse_checks"
        evidence = "dependency, compile, SFTP and doc-test"
        remaining = "package tests and the requested artifact stages"
    with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
        output.write(f"{output_name}=true\n")
    with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a") as summary:
        summary.write(
            f"Reusing passed {evidence} gates from "
            f"[run {run_id}](https://github.com/{REPO}/actions/runs/{run_id}) "
            f"at `{source}`. App and passed-gate inputs are unchanged. "
            f"Running only {remaining}.{extra_evidence}\n"
        )


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.SubprocessError) as error:
        print(f"Batch resume refused: {error}", file=sys.stderr)
        sys.exit(1)
