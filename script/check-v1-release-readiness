                'Channel::Oss => "Zaplex"',
            ),
        ),
        "release workflow architectures": (
            release_workflow,
            (
                "dmg_name_suffix: arm64",
                'script/bundle -Channel $CHANNEL -skip_build_installer --arch x64',
                'script/bundle --channel "$CHANNEL" --arch x86_64 --packages appimage,deb',
            ),
        ),
    }
    for label, (text, markers) in contracts.items():
        for marker in markers:
            if marker not in text:
                raise ReadinessError(f"{label} lacks release-name contract {marker!r}")


def live_sftp_commit_boundaries_have_a_real_protocol_gate(root: Path) -> None:
    workflow = read_text(root / ".github/workflows/live-sftp-safety.yml")
    backend = read_text(root / "app/src/sftp_manager/sftp_backend.rs")
    tests = read_text(root / "app/src/sftp_manager/sftp_backend_tests.rs")
    server = read_text(root / "app/src/remote_server/safe_file.rs")
    proto = read_text(root / "crates/remote_server/proto/remote_server.proto")
    contracts = {
        "live SFTP workflow": (
            workflow,
            (
                "pull_request:",
                "openssh-server",
                "Subsystem sftp internal-sftp",
                "cargo test --locked -p warp --lib live_sftp_remote_safe_rename -- --ignored",
            ),
        ),
        "live SFTP fault cases": (
            tests,
            (
                "live_sftp_remote_safe_rename_replays_when_request_was_not_applied",
                "live_sftp_remote_safe_rename_recovers_when_response_was_lost",
                "LiveRenameFault::BeforeMutation",
                "LiveRenameFault::AfterMutation",
            ),
        ),
        "client recovery state": (
            backend,
            (
                "RemoteRecoveryAction::Rename",
                "RemoteRecoveryResolution::SourceRestored",
                "DestinationCommittedSourcePreserved",
                "take_recovery_source_restored",
            ),
        ),
        "server acknowledgement journal": (
            server,
            (
                "consume_applied_mutation",
                "JournalState::Applied",
                "source_preserved_after_commit",
            ),
        ),
        "wire recovery metadata": (
            proto,
            ("bool source_preserved_after_commit = 3;",),
        ),
    }
    for label, (text, markers) in contracts.items():
        for marker in markers:
            if marker not in text:
                raise ReadinessError(f"{label} lacks {marker!r}")


def markdown_rows(text: str, start_marker: str, end_marker: str) -> list[list[str]]:
    try:
        section = text.split(start_marker, 1)[1].split(end_marker, 1)[0]
    except IndexError as error:
        raise ReadinessError(f"missing section markers {start_marker} / {end_marker}") from error
    rows = []
    for line in section.splitlines():
        if not line.startswith("|"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if cells and re.fullmatch(r"[RM][0-9]{2}", cells[0]):
            rows.append(cells)
    return rows


def first_ten_user_risks_have_mitigation_recovery_and_validation(root: Path) -> None:
    text = read_text(root / "docs/release/1.0-readiness.md")
    rows = markdown_rows(text, "<!-- risk-register:start -->", "<!-- risk-register:end -->")
    if len(rows) != 10:
        raise ReadinessError(f"risk register has {len(rows)} rows instead of 10")
    expected_ids = {f"R{index:02d}" for index in range(1, 11)}
    if {row[0] for row in rows} != expected_ids:
        raise ReadinessError("risk register IDs must be R01 through R10")
    for row in rows:
        if len(row) != 7:
            raise ReadinessError(
                f"{row[0]} must contain trigger, impact, detection, mitigation, recovery and validation"
            )
        if any(not cell or cell in {"—", "-", "TBD"} for cell in row[1:]):
            raise ReadinessError(f"{row[0]} contains an empty risk field")


def manual_release_matrix_has_result_and_evidence_for_every_row(
    root: Path, phase: str
) -> None:
    text = read_text(root / "docs/release/1.0-readiness.md")
    rows = markdown_rows(text, "<!-- runtime-matrix:start -->", "<!-- runtime-matrix:end -->")
    by_id = {row[0]: row for row in rows}
    if set(by_id) != set(EXPECTED_MATRIX_ROWS):
        missing = sorted(set(EXPECTED_MATRIX_ROWS) - set(by_id))
        extra = sorted(set(by_id) - set(EXPECTED_MATRIX_ROWS))
        raise ReadinessError(f"runtime matrix mismatch; missing={missing}, extra={extra}")
    for row_id, required_scenario in EXPECTED_MATRIX_ROWS.items():
        row = by_id[row_id]
        if len(row) != 5:
            raise ReadinessError(
                f"{row_id} must contain scenario, result, artifact and evidence"
            )
        _, scenario, result, artifact, evidence = row
        if scenario != required_scenario:
            raise ReadinessError(
                f"{row_id} scenario differs: {scenario!r} != {required_scenario!r}"
            )
        if phase == "a":
            if (result, artifact, evidence) != ("PENDING_ARTIFACT", "—", "—"):
                raise ReadinessError(
                    f"{row_id} must remain PENDING_ARTIFACT without artifact evidence in Phase A"
                )
        elif result != "PASS" or artifact in {"", "—", "-"} or evidence in {"", "—", "-"}:
            raise ReadinessError(
                f"{row_id} needs PASS, an artifact ID and independent evidence in Phase B"
            )


def copy_fixture(root: Path, destination: Path, relative_paths: tuple[str, ...]) -> None:
    for relative_path in relative_paths:
        source = root / relative_path
        target = destination / relative_path
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)


def expect_readiness_failure(name: str, check) -> None:
    try:
        check()
    except ReadinessError:
        print(f"PASS red fixture: {name}")
        return
    raise ReadinessError(f"red fixture unexpectedly passed: {name}")


