        ),
        "Linux updater": (
            read_text(root / "app/src/autoupdate/linux.rs"),
            ('const OSS_APPIMAGE_ASSET_NAME: &str = "Zaplex-x86_64.AppImage";',),
        ),
        "Windows bundle": (
            read_text(root / "script/windows/bundle.ps1"),
            (
                "$APP_NAME = 'Zaplex'",
                '$INSTALLER_NAME = "$($APP_NAME)$($FILE_ENDING)"',
            ),
        ),
        "Windows updater": (
            read_text(root / "app/src/autoupdate/windows.rs"),
