RELEASE_MARKER = re.compile(
    r"\bpre[- ]release\b"
    r"|\brelease candidate\b"
    r"|\b(?:beta|preview)\s+(?:build|release|channel|version)\b"
    r"|\brc[0-9]+\b",
    re.IGNORECASE,
)


class ReadinessError(Exception):
    pass


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise ReadinessError(f"cannot read {path}: {error}") from error


def planned_red_test_names(root: Path) -> set[str]:
    plan = read_text(root / "docs/2026-07-23-v1-implementation-plan.md")
    names: set[str] = set()
    for block in re.findall(
        r"^- \*\*Rot-Tests:\*\*(.*?)(?=^- \*\*Dateidomäne:)",
        plan,
        re.MULTILINE | re.DOTALL,
    ):
        names.update(re.findall(r"`([A-Za-z_][A-Za-z0-9_]*)`", block))
    if not names:
        raise ReadinessError("implementation plan contains no named red tests")
    return names


def implemented_test_symbols(root: Path) -> set[str]:
    symbols: set[str] = set()
    rust_function = re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)",
        re.MULTILINE,
    )
    for source_root in (root / "app", root / "crates"):
        for path in source_root.rglob("*.rs"):
            symbols.update(rust_function.findall(read_text(path)))

    verifier = read_text(root / "script/check-v1-release-readiness")
    symbols.update(re.findall(r"^def\s+([A-Za-z_][A-Za-z0-9_]*)", verifier, re.MULTILINE))
    symbols.update(
        re.findall(
            r'expect_readiness_failure\(\s*"([A-Za-z_][A-Za-z0-9_]*)"',
            verifier,
            re.MULTILINE,
        )
    )
    return symbols


def planned_red_tests_have_authoritative_evidence(root: Path) -> None:
    require_planned_test_evidence(
        planned_red_test_names(root), implemented_test_symbols(root)
    )


def open_issue_red_tests_have_authoritative_evidence(root: Path) -> None:
    try:
        snapshot = json.loads(
            read_text(root / "docs/release/1.0-open-issue-tests.json")
        )
    except json.JSONDecodeError as error:
        raise ReadinessError(f"open-issue test snapshot is invalid JSON: {error}") from error
    require_open_issue_test_evidence(
        snapshot,
        implemented_test_symbols(root),
        read_text(root / "docs/release/1.0-readiness.md"),
    )


def legacy_open_issues_have_authoritative_evidence(root: Path) -> None:
    try:
        snapshot = json.loads(
            read_text(root / "docs/release/1.0-open-issue-tests.json")
        )
    except json.JSONDecodeError as error:
        raise ReadinessError(f"open-issue test snapshot is invalid JSON: {error}") from error
    require_legacy_issue_evidence(
        snapshot,
        implemented_test_symbols(root),
        read_text(root / "docs/release/1.0-readiness.md"),
        read_text(root / "specs/APP-3891/PRODUCT.md"),
        read_text(root / "app/src/terminal/input.rs"),
        read_text(root / "app/src/terminal/input/cli_agent.rs"),
        read_text(root / "app/src/terminal/view/use_agent_footer/mod.rs"),
        read_text(root / "docs/ui/cli-agent-image-attachment.html"),
    )


def require_match(text: str, pattern: str, label: str) -> str:
    match = re.search(pattern, text, re.MULTILINE | re.DOTALL)
    if match is None:
        raise ReadinessError(f"cannot find {label}")
    return match.group(1)


def manifest_version(path: Path) -> str:
    text = read_text(path)
    package = require_match(text, r"\[package\](.*?)(?:\n\[|\Z)", f"[package] in {path}")
    return require_match(package, r'^version\s*=\s*"([^"]+)"', f"package version in {path}")


def lock_version(path: Path, package_name: str) -> str:
    text = read_text(path)
    blocks = re.findall(r"\[\[package\]\]\n(.*?)(?=\n\[\[package\]\]|\Z)", text, re.DOTALL)
    for block in blocks:
        name = re.search(r'^name\s*=\s*"([^"]+)"', block, re.MULTILINE)
        if name is not None and name.group(1) == package_name:
            return require_match(
                block,
                r'^version\s*=\s*"([^"]+)"',
                f"{package_name} version in {path}",
            )
    raise ReadinessError(f"cannot find package {package_name!r} in {path}")


def plist_versions(path: Path) -> tuple[str, str]:
    try:
        with path.open("rb") as plist_file:
            values = plistlib.load(plist_file)
    except (OSError, plistlib.InvalidFileException) as error:
        raise ReadinessError(f"cannot read plist {path}: {error}") from error
    short = values.get("CFBundleShortVersionString")
    build = values.get("CFBundleVersion")
    if not isinstance(short, str) or not isinstance(build, str):
        raise ReadinessError(f"{path} lacks both Apple version fields")
    return short, build


def embedded_plist_versions(path: Path) -> tuple[str, str]:
    text = read_text(path)
    short = require_match(
        text,
        r"<key>CFBundleShortVersionString</key>\s*<string>([^<]+)</string>",
        f"embedded CFBundleShortVersionString in {path}",
    )
    build = require_match(
        text,
        r"<key>CFBundleVersion</key>\s*<string>([^<]+)</string>",
        f"embedded CFBundleVersion in {path}",
    )
    return short, build


def release_metadata_is_consistent_across_manifests_resources_and_docs(root: Path) -> None:
    version = read_text(root / "VERSION").strip()
    if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version) is None:
        raise ReadinessError(f"VERSION is not a stable semantic version: {version!r}")

    observed = {
        "app/Cargo.toml": manifest_version(root / "app/Cargo.toml"),
        "Cargo.lock warp package": lock_version(root / "Cargo.lock", "warp"),
        "CLI-Info.plist short": plist_versions(
            root / "app/assets/resources/mac/CLI-Info.plist"
        )[0],
        "CLI-Info.plist build": plist_versions(
            root / "app/assets/resources/mac/CLI-Info.plist"
        )[1],
        "DockTilePlugin short": plist_versions(root / "app/DockTilePlugin/Info.plist")[0],
        "DockTilePlugin build": plist_versions(root / "app/DockTilePlugin/Info.plist")[1],
        "embedded Info.plist short": embedded_plist_versions(
            root / "app/src/bin/zaplex.rs"
        )[0],
        "embedded Info.plist build": embedded_plist_versions(
            root / "app/src/bin/zaplex.rs"
        )[1],
        "Windows installer default": require_match(
            read_text(root / "script/windows/windows-installer.iss"),
            r'#define MyAppVersion "([^"]+)"',
            "MyAppVersion in script/windows/windows-installer.iss",
        ),
    }
    mismatches = {label: value for label, value in observed.items() if value != version}
    if mismatches:
        details = ", ".join(f"{label}={value}" for label, value in mismatches.items())
        raise ReadinessError(f"release version {version} is inconsistent: {details}")

    release_config = json.loads(
        read_text(root / ".github/workflows/release_configurations.json")
    )
    channels = release_config.get("channels", [])
    if (
        len(channels) != 1
        or channels[0].get("channel") != "oss"
        or channels[0].get("is_prerelease") is not False
        or channels[0].get("release_base_name") != "Zaplex"
    ):
        raise ReadinessError("release configuration is not the stable Zaplex OSS channel")
    if version not in str(channels[0].get("release_body_text", "")):
        raise ReadinessError("release body does not contain VERSION")

    required_doc_markers = {
        "README.md": f"Zaplex {version}",
        "CHANGELOG.md": f"[{version}]",
        "docs/release/1.0-user-guide.md": f"Zaplex {version}",
        "docs/release/1.0-readiness.md": f"`{V1_BASE_SHA}`",
    }
    for relative_path, marker in required_doc_markers.items():
        if marker not in read_text(root / relative_path):
            raise ReadinessError(f"{relative_path} does not contain {marker!r}")

    expected_tag = f"v{version}"
    for workflow in (
        ".github/workflows/test-dmg.yml",
        ".github/workflows/zap_release.yml",
    ):
        if expected_tag not in read_text(root / workflow):
            raise ReadinessError(f"{workflow} does not contain default tag {expected_tag}")

    test_dmg_workflow = read_text(root / ".github/workflows/test-dmg.yml")
    require_match(
        test_dmg_workflow,
        r"\n      fast:\n.*?\n        default: (false)\n",
        "release-profile default in .github/workflows/test-dmg.yml",
    )


def shipped_release_copy_contains_no_rc_beta_or_preview_markers(root: Path) -> None:
    shipped_copy = (
        "README.md",
        "docs/release/1.0-user-guide.md",
        ".github/workflows/release_configurations.json",
        "app/i18n/en/warp.ftl",
        "app/i18n/de/warp.ftl",
    )
    findings: list[str] = []
    for relative_path in shipped_copy:
        for line_number, line in enumerate(read_text(root / relative_path).splitlines(), 1):
            if RELEASE_MARKER.search(line):
                findings.append(f"{relative_path}:{line_number}: {line.strip()}")
    if findings:
        raise ReadinessError("release markers remain in shipped copy:\n" + "\n".join(findings))


def release_tree_does_not_contain_rc_handoff_document(root: Path) -> None:
    handoffs = sorted(
        path.relative_to(root).as_posix()
        for path in (root / "docs").glob("*handoff*")
        if path.is_file()
    )
    if handoffs:
        raise ReadinessError("temporary release handoff remains: " + ", ".join(handoffs))


def release_tree_descends_from_recorded_v1_base(root: Path) -> None:
    result = subprocess.run(
        ["git", "-C", str(root), "merge-base", "--is-ancestor", V1_BASE_SHA, "HEAD"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or f"git exited with {result.returncode}"
        raise ReadinessError(
            f"HEAD does not descend from documented V1_BASE_SHA {V1_BASE_SHA}: {detail}"
        )


def release_workflows_bundle_version_matched_remote_server(root: Path) -> None:
    release_workflow = read_text(root / ".github/workflows/zap_release.yml")
    test_workflow = read_text(root / ".github/workflows/test-dmg.yml")
    setup_source = read_text(root / "crates/remote_server/src/setup.rs")

    required_release_markers = (
        "build_remote_server:",
        "name: zap-cli-linux-x86_64",
        "path: resources/bundled/remote-server/",
        "GIT_RELEASE_TAG: ${{ needs.prepare_metadata.outputs.release_tag }}",
        'git merge-base --is-ancestor "$RELEASE_COMMIT" refs/remotes/origin/main',
        'elif [[ "$GITHUB_REF" != "refs/heads/main" ]]',
        'tar -czf zap-linux-x86_64.tar.gz -C "$staging" zaplex resources',
        "hashFiles('Cargo.lock', 'Cargo.toml', '.cargo/config.toml', 'app/**', 'crates/**', 'resources/**', 'rust-toolchain.toml', 'script/bundle', 'script/linux/bundle', 'script/prepare_bundled_resources')",
    )
    for marker in required_release_markers:
        if marker not in release_workflow:
            raise ReadinessError(
                f"zap_release.yml does not bundle the version-matched remote-server: {marker!r}"
            )

    required_test_markers = (
        "build_remote_server:",
        "path: resources/bundled/remote-server/",
        "GIT_RELEASE_TAG: ${{ inputs.dmg_tag }}",
        "hashFiles('Cargo.lock', 'Cargo.toml', '.cargo/config.toml', 'app/**', 'crates/**', 'resources/**', 'rust-toolchain.toml', 'script/bundle', 'script/linux/bundle', 'script/prepare_bundled_resources')",
    )
    for marker in required_test_markers:
        if marker not in test_workflow:
            raise ReadinessError(
                f"test-dmg.yml does not bundle the version-matched remote-server: {marker!r}"
            )

    if "https://github.com/byte5ai/zaplex/releases/" not in setup_source:
        raise ReadinessError("remote-server fallback does not use byte5ai/zaplex releases")
    if "https://github.com/zerx-lab/warp/releases/" in setup_source:
        raise ReadinessError("remote-server fallback still references the upstream release repo")


def macos_distribution_uses_developer_id_and_api_key_notarization(root: Path) -> None:
    bundle = read_text(root / "script/macos/bundle")
    release_workflow = read_text(root / ".github/workflows/zap_release.yml")
    test_workflow = read_text(root / ".github/workflows/test-dmg.yml")

    bundle_markers = (
        "prepare_distribution_signing_inputs()",
        "prepare_distribution_signing_keychain()",
        "umask 077",
        'security import "$CODESIGN_CERT_PATH"',
        "-f pkcs12",
        "security find-identity -v -p codesigning",
        "Developer ID Application",
        'xcrun notarytool submit "$NOTARIZATION_ARTIFACT"',
        '--key "$NOTARY_KEY_PATH"',
        '--key-id "$MACOS_NOTARY_KEY_ID"',
        '--issuer "$MACOS_NOTARY_ISSUER_ID"',
        'xcrun stapler validate "$DMG_DIR/$DMG_NAME"',
        'security delete-keychain "$CODESIGN_KEYCHAIN_PATH"',
        'rm -f "$CODESIGN_CERT_PATH"',
        'rm -f "$NOTARY_KEY_PATH"',
    )
    for marker in bundle_markers:
        if marker not in bundle:
            raise ReadinessError(f"macOS distribution signing lacks {marker!r}")
    if re.search(r"security import.*?\n(?:.*?\n)*?\s+-t cert", bundle) is not None:
        raise ReadinessError("PKCS#12 import is restricted to certificates and may omit its key")

    workflow_markers = (
        "--read-passwords-from-env --check-signing-only",
        "MACOS_CERTIFICATE_P12_BASE64: ${{ secrets.MACOS_CERTIFICATE_P12_BASE64 }}",
        "MACOS_CERTIFICATE_PASSWORD: ${{ secrets.MACOS_CERTIFICATE_PASSWORD }}",
        "MACOS_NOTARY_KEY_ID: ${{ secrets.MACOS_NOTARY_KEY_ID }}",
        "MACOS_NOTARY_ISSUER_ID: ${{ secrets.MACOS_NOTARY_ISSUER_ID }}",
        "MACOS_NOTARY_KEY_P8_BASE64: ${{ secrets.MACOS_NOTARY_KEY_P8_BASE64 }}",
        "Build, sign and notarize",
    )
    for workflow_name, workflow in (
        ("zap_release.yml", release_workflow),
        ("test-dmg.yml", test_workflow),
    ):
        for marker in workflow_markers:
            if marker not in workflow:
                raise ReadinessError(f"{workflow_name} lacks signing contract {marker!r}")


