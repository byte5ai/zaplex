#!/usr/bin/env python3
"""Optional execution events for existing non-Rust fixture boundaries."""
import json
import os
from pathlib import Path
import sys


def record(identity, status="pass"):
    destination = os.environ.get("ZAPLEX_NONRUST_EVENTS")
    if destination is None:
        return
    if not isinstance(identity, str) or not identity or status not in {"pass", "fail", "skip"}:
        raise ValueError("invalid non-Rust case event")
    # Each suite has its own file; children execute synchronously. One append
    # records one completed existing scenario, never an inferred source count.
    with Path(destination).open("a", encoding="utf-8") as stream:
        stream.write(json.dumps({"id": identity, "status": status}) + "\n")


if __name__ == "__main__":
    if len(sys.argv) not in (2, 3):
        raise SystemExit("usage: test-suite-nonrust-events CASE_ID [pass|fail|skip]")
    record(*sys.argv[1:])
