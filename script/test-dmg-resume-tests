#!/usr/bin/env python3
"""Negative controls for reusing expensive build evidence."""

import copy
import runpy
from pathlib import Path
import unittest

resume = runpy.run_path(str(Path(__file__).with_name("test-dmg-resume")))


class ResumeTests(unittest.TestCase):
    def setUp(self):
        self.run = {
            "status": "completed", "conclusion": "failure",
            "event": "workflow_dispatch", "head_branch": "main",
            "path": ".github/workflows/ci-batch.yml", "head_sha": "a" * 40,
            "head_repository": {"full_name": "byte5ai/zaplex"},
        }
        self.jobs = [{"name": name, "conclusion": "success"} for name in resume["PASSED"]]
        self.jobs.append({"name": resume["APP"], "conclusion": "failure"})
        self.artifacts = [{"name": "zap-remote-server-linux-x86_64", "expired": False}]

    def check(self, paths=()):
        resume["validate"](self.run, self.jobs, self.artifacts, paths)

    def test_original_batch_can_resume_with_only_workflow_and_evidence_changes(self):
        self.check([".github/workflows/test-dmg.yml", "specs/GH-564/README.md"])

    def test_untrusted_or_unfinished_run_is_rejected(self):
        for key, value in [("head_branch", "feature"), ("status", "in_progress"),
                           ("event", "pull_request"), ("conclusion", "success"),
                           ("path", ".github/workflows/test-dmg.yml"),
                           ("head_repository", {"full_name": "other/repo"}),
                           ("head_sha", "main")]:
            with self.subTest(key=key):
                bad = dict(self.run, **{key: value})
                with self.assertRaises(ValueError):
                    resume["validate"](bad, self.jobs, self.artifacts, [])

    def test_every_reused_gate_must_be_successful(self):
        for index in range(len(self.jobs) - 1):
            for conclusion in ("skipped", "failure", None):
                jobs = copy.deepcopy(self.jobs)
                jobs[index]["conclusion"] = conclusion
                with self.subTest(job=jobs[index]["name"], conclusion=conclusion):
                    with self.assertRaises(ValueError):
                        resume["validate"](self.run, jobs, self.artifacts, [])

    def test_missing_gate_is_rejected(self):
        self.jobs.pop(0)
        with self.assertRaises(ValueError):
            self.check()

    def test_other_failure_is_rejected(self):
        self.jobs.append({"name": "other gate", "conclusion": "failure"})
        with self.assertRaises(ValueError):
            self.check()

    def test_successful_app_is_not_rebuilt(self):
        self.jobs[-1]["conclusion"] = "success"
        with self.assertRaises(ValueError):
            self.check()

    def test_duplicate_jobs_are_rejected(self):
        self.jobs.append(self.jobs[0])
        with self.assertRaises(ValueError):
            self.check()

    def test_artifact_must_be_unique_available_and_unexpired(self):
        for artifacts in ([], self.artifacts * 2,
                          [dict(self.artifacts[0], expired=True)]):
            with self.assertRaises(ValueError):
                resume["validate"](self.run, self.jobs, artifacts, [])

    def test_changed_build_or_test_inputs_are_rejected(self):
        for path in ("app/src/main.rs", "Cargo.lock", "rust-toolchain.toml",
                     ".github/workflows/gui-acceptance.yml", "script/macos/bundle"):
            with self.subTest(path=path), self.assertRaises(ValueError):
                self.check([path])

    def test_version_and_profile_must_match(self):
        batch = "  test_dmg:\n    with:\n      fast: false\n"
        validate = resume["validate_profile"]
        validate(batch, "1.2.2\n", "v1.2.2", "false")
        for args in [(batch, "1.2.2", "v1.2.3", "false"),
                     (batch, "1.2.2", "v1.2.2", "true"),
                     (batch.replace("false", "true"), "1.2.2", "v1.2.2", "false")]:
            with self.assertRaises(ValueError):
                validate(*args)


if __name__ == "__main__":
    unittest.main()
