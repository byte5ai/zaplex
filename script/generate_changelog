#!/usr/bin/env bash
#
# Preview Zap release notes locally with the same cliff.toml and published-
# release boundary used by .github/workflows/zap_release.yml.
#
# Usage:
#   script/generate_changelog                   # Latest published release to HEAD
#   script/generate_changelog v2026.05.27.2     # Explicit upcoming release tag
#   script/generate_changelog v2026.05.27.2 v2026.05.06.preview
#                                               # Explicit previous release tag
#
# Output is written to stdout; redirect it to save a preview.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

if ! command -v git-cliff >/dev/null 2>&1; then
    echo "error: git-cliff is not installed." >&2
    echo "       Install it with the platform package manager, cargo, or cargo-binstall." >&2
    exit 1
fi

THIS_TAG="${1:-HEAD}"
PREV_TAG="${2:-}"

if [[ -z "$PREV_TAG" ]]; then
    if ! command -v gh >/dev/null 2>&1; then
        echo "error: gh is required to resolve the latest published release." >&2
        echo "       Pass an explicit previous tag as the second argument to work offline." >&2
        exit 1
    fi
    if ! PREV_TAG=$(gh api "repos/byte5ai/zaplex/releases/latest" --jq .tag_name 2>/dev/null); then
        # Distinguish "no published release yet" from an unavailable API.
        gh api "repos/byte5ai/zaplex/releases?per_page=1" --silent >/dev/null
        PREV_TAG=""
    fi
fi

ARGS=(--config cliff.toml --strip header --tag "$THIS_TAG")
if [[ -n "$PREV_TAG" ]]; then
    ARGS+=("${PREV_TAG}..HEAD")
    echo "# preview: ${PREV_TAG} -> ${THIS_TAG}" >&2
else
    echo "# preview: first release -> ${THIS_TAG}" >&2
fi

git-cliff "${ARGS[@]}"
