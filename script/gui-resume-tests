#!/usr/bin/env python3
"""Reject stale or mismatched DMGs before starting a GUI runner."""

import copy
import os
from pathlib import Path
import runpy
import tempfile
import unittest
from unittest.mock import patch

helpers = runpy.run_path(str(Path(__file__).with_name("gui-resume")))
validate = helpers["validate"]


class GuiResumeTests(unittest.TestCase):
    def setUp(self):
        self.run = {
            "status": "completed", "conclusion": "success", "event": "workflow_dispatch",
            "head_branch": "main", "path": ".github/workflows/test-dmg.yml",
            "head_repository": {"full_name": "byte5ai/zaplex"}, "head_sha": "a" * 40,
        }
        self.jobs = [{"name": n, "conclusion": "success"} for n in (
            "Verify Phase A release readiness", "Prepare Test app (macOS Apple Silicon)",
            "Sign and package Test DMG (macOS Apple Silicon)")]
        self.jobs.append({"name": "Verify installed DMG user flows", "conclusion": "skipped"})
        self.artifacts = [{"name": "zap-test-dmg-aarch64", "expired": False}]

    def test_existing_dmg_with_identical_app_can_be_tested(self):
        validate(self.run, self.jobs, self.artifacts, [".github/workflows/test-dmg.yml"])

    def test_wrong_run_or_source_is_rejected(self):
        for key, value in [("status", "in_progress"), ("conclusion", "failure"),
                           ("head_branch", "feature"), ("event", "pull_request"),
                           ("path", ".github/workflows/ci-batch.yml"), ("head_sha", "main"),
                           ("head_repository", {"full_name": "other/repo"})]:
            with self.subTest(key=key), self.assertRaises(ValueError):
                validate(dict(self.run, **{key: value}), self.jobs, self.artifacts, [])

    def test_artifact_jobs_must_be_successful(self):
        for i in range(3):
            jobs = copy.deepcopy(self.jobs)
            jobs[i]["conclusion"] = "failure"
            with self.assertRaises(ValueError):
                validate(self.run, jobs, self.artifacts, [])

    def test_already_passed_gui_is_not_repeated(self):
        self.jobs[-1]["conclusion"] = "success"
        with self.assertRaises(ValueError):
            validate(self.run, self.jobs, self.artifacts, [])

    def test_expired_missing_duplicate_artifacts_are_rejected(self):
        for artifacts in ([], self.artifacts * 2, [dict(self.artifacts[0], expired=True)]):
            with self.assertRaises(ValueError):
                validate(self.run, self.jobs, artifacts, [])

    def test_changed_app_or_test_inputs_are_rejected(self):
        for path in ("Cargo.lock", "app/src/main.rs", "script/macos/gui-tests/run",
                     ".github/workflows/gui-acceptance.yml"):
            with self.subTest(path=path), self.assertRaises(ValueError):
                validate(self.run, self.jobs, self.artifacts, [path])


class BatchExplorationTests(unittest.TestCase):
    def setUp(self):
        self.run = {
            "status": "completed", "conclusion": "success", "event": "workflow_dispatch",
            "head_branch": "main", "path": ".github/workflows/ci-batch.yml",
            "head_repository": {"full_name": "byte5ai/zaplex"}, "head_sha": "b" * 40,
        }
        self.jobs = [{"name": "test_dmg / " + name, "conclusion": "success"} for name in (
            "Verify Phase A release readiness", "Build bundled remote-server (Linux musl x86_64)",
            "Prepare Test app (macOS Apple Silicon)",
            "Sign and package Test DMG (macOS Apple Silicon)",
            "Verify installed DMG user flows / Installed DMG user flows",
        )]
        self.artifacts = [{"name": "zap-test-dmg-aarch64", "expired": False}]

    def validate(self, *, run=None, jobs=None, artifacts=None, source=None):
        helpers["validate_batch_exploration"](
            self.run if run is None else run, self.jobs if jobs is None else jobs,
            self.artifacts if artifacts is None else artifacts,
            self.run["head_sha"] if source is None else source,
        )

    def test_current_successful_batch_can_be_explored(self):
        self.validate()

    def test_different_app_commit_is_rejected(self):
        with self.assertRaises(ValueError):
            self.validate(source="c" * 40)

    def test_untrusted_or_unfinished_batch_is_rejected(self):
        for key, value in [("status", "in_progress"), ("conclusion", "failure"),
                           ("head_branch", "feature"), ("event", "pull_request"),
                           ("path", ".github/workflows/other.yml"), ("head_sha", "main"),
                           ("head_repository", {"full_name": "other/repo"})]:
            with self.subTest(key=key), self.assertRaises(ValueError):
                self.validate(run=dict(self.run, **{key: value}))

    def test_each_artifact_and_gui_prerequisite_must_pass(self):
        for index in range(len(self.jobs)):
            for result in ("failure", "skipped", "cancelled"):
                jobs = copy.deepcopy(self.jobs)
                jobs[index]["conclusion"] = result
                with self.subTest(index=index, result=result), self.assertRaises(ValueError):
                    self.validate(jobs=jobs)

    def test_missing_or_duplicate_jobs_are_rejected(self):
        for jobs in (self.jobs[:-1], self.jobs + [self.jobs[0]]):
            with self.assertRaises(ValueError):
                self.validate(jobs=jobs)

    def test_expired_missing_or_duplicate_artifact_is_rejected(self):
        for artifacts in ([], self.artifacts * 2, [dict(self.artifacts[0], expired=True)]):
            with self.assertRaises(ValueError):
                self.validate(artifacts=artifacts)


class BatchResumeTests(BatchExplorationTests):
    def setUp(self):
        super().setUp()
        self.run["conclusion"] = "failure"
        self.jobs[-1]["conclusion"] = "failure"

    def validate(self, *, run=None, jobs=None, artifacts=None, source=None):
        helpers["validate_batch_resume"](
            self.run if run is None else run, self.jobs if jobs is None else jobs,
            self.artifacts if artifacts is None else artifacts,
            self.run["head_sha"] if source is None else source,
        )

    def test_current_successful_batch_can_be_explored(self):
        for result in ("failure", "cancelled", "skipped", None):
            with self.subTest(result=result):
                self.jobs[-1]["conclusion"] = result
                self.validate()
        self.validate(jobs=self.jobs[:-1])

    def test_untrusted_or_unfinished_batch_is_rejected(self):
        for key, value in [("status", "in_progress"), ("conclusion", "timed_out"),
                           ("head_branch", "feature"), ("event", "pull_request"),
                           ("path", ".github/workflows/other.yml"), ("head_sha", "main"),
                           ("head_repository", {"full_name": "other/repo"})]:
            with self.subTest(key=key), self.assertRaises(ValueError):
                self.validate(run=dict(self.run, **{key: value}))

    def test_each_artifact_and_gui_prerequisite_must_pass(self):
        for index in range(len(self.jobs) - 1):
            for result in ("failure", "skipped", "cancelled"):
                jobs = copy.deepcopy(self.jobs)
                jobs[index]["conclusion"] = result
                with self.subTest(index=index, result=result), self.assertRaises(ValueError):
                    self.validate(jobs=jobs)

    def test_missing_or_duplicate_jobs_are_rejected(self):
        for jobs in (self.jobs[1:], self.jobs + [self.jobs[0]]):
            with self.assertRaises(ValueError):
                self.validate(jobs=jobs)

    def test_already_passed_gui_is_not_repeated(self):
        self.jobs[-1]["conclusion"] = "success"
        with self.assertRaises(ValueError):
            self.validate()

    def test_skipped_reusable_call_can_be_resumed(self):
        self.jobs[-1] = {"name": "test_dmg / Verify installed DMG user flows", "conclusion": "skipped"}
        self.validate()

    def test_conflicting_gui_jobs_are_rejected(self):
        self.jobs.append({"name": "test_dmg / Verify installed DMG user flows", "conclusion": "success"})
        with self.assertRaises(ValueError):
            self.validate()


class CallerAcceptanceTests(unittest.TestCase):
    def test_only_main_resume_workflow_can_attest_full_acceptance(self):
        expected = {
            "GUI_ACCEPTANCE_IN_CALLER": "true",
            "GITHUB_WORKFLOW": "Resume installed DMG acceptance",
            "GITHUB_EVENT_NAME": "workflow_dispatch",
            "GITHUB_REF": "refs/heads/main",
        }
        with patch.dict(os.environ, expected, clear=True):
            self.assertTrue(helpers["caller_proved_full_suite"]())
        for key in expected:
            for value in ("", "other"):
                with self.subTest(key=key, value=value), patch.dict(
                    os.environ, dict(expected, **{key: value}), clear=True
                ):
                    self.assertFalse(helpers["caller_proved_full_suite"]())


class CompletionRunTests(unittest.TestCase):
    def setUp(self):
        self.run = {"status": "completed", "conclusion": "success", "event": "workflow_dispatch",
                    "head_branch": "main", "path": ".github/workflows/gui-resume.yml",
                    "head_repository": {"full_name": "byte5ai/zaplex"}}
        self.jobs = [{"name": name, "conclusion": "success"} for name in
                     ("Verify existing DMG provenance", "gui / Installed DMG user flows")]

    def test_completed_main_continuation_is_trusted(self):
        helpers["validate_completion_run"](self.run, self.jobs)

    def test_untrusted_or_incomplete_run_is_rejected(self):
        for key, value in (("status", "in_progress"), ("conclusion", "failure"),
                           ("event", "pull_request"), ("head_branch", "feature"),
                           ("path", ".github/workflows/other.yml"),
                           ("head_repository", {"full_name": "other/repo"})):
            with self.subTest(key=key), self.assertRaises(ValueError):
                helpers["validate_completion_run"](dict(self.run, **{key: value}), self.jobs)

    def test_missing_duplicate_or_unsuccessful_jobs_are_rejected(self):
        for jobs in ([], self.jobs[:1], self.jobs * 2,
                     [dict(job, conclusion="skipped") for job in self.jobs],
                     [dict(job, conclusion="failure") for job in self.jobs]):
            with self.assertRaises(ValueError):
                helpers["validate_completion_run"](self.run, jobs)

    def test_intermediate_gui_failure_preserves_only_successful_prerequisites(self):
        run = dict(self.run, conclusion="failure")
        jobs = [self.jobs[0], dict(self.jobs[1], conclusion="failure")]
        helpers["validate_completion_run"](run, jobs, allow_partial=True)
        for bad_jobs in ([dict(jobs[0], conclusion="failure"), jobs[1]], self.jobs,
                         jobs + [{"name": "extra prerequisite", "conclusion": "failure"}]):
            with self.assertRaises(ValueError):
                helpers["validate_completion_run"](run, bad_jobs, allow_partial=True)
        for conclusion in ("cancelled", "timed_out", "skipped"):
            with self.assertRaises(ValueError):
                helpers["validate_completion_run"](dict(run, conclusion=conclusion), jobs, allow_partial=True)

    def test_continuation_ids_preserve_order_and_reject_ambiguous_input(self):
        parse = helpers["continuation_ids"]
        self.assertEqual(parse("456,789"), ["456", "789"])
        self.assertEqual(parse("456"), ["456"])
        for invalid in ("", "0", "0456", "456,456", "456,", "456, 789", "main",
                        ",".join(str(n) for n in range(1, 12))):
            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
                parse(invalid)


class DiagnosticScopeTests(unittest.TestCase):
    def setUp(self):
        fixture = BatchResumeTests()
        fixture.setUp()
        self.run, self.jobs, self.artifacts = fixture.run, fixture.jobs, fixture.artifacts

    def invoke(self, directory, overrides=None, jobs=None):
        env = {"ARTIFACT_RUN_ID": "123", "APP_SOURCE_SHA": self.run["head_sha"],
               "GITHUB_REPOSITORY": "byte5ai/zaplex", "GITHUB_REF": "refs/heads/main",
               "GITHUB_EVENT_NAME": "workflow_dispatch", "GUI_EXPLORATION": "true",
               "GUI_DIAGNOSTIC": "true", "GITHUB_WORKSPACE": directory,
               "GITHUB_STEP_SUMMARY": str(Path(directory) / "summary.md")}
        env.update(overrides or {})
        responses = {"jobs": self.jobs if jobs is None else jobs, "artifacts": self.artifacts}
        with patch.dict(os.environ, env, clear=True), patch.dict(helpers["main"].__globals__,
                api=lambda _: self.run, pages=lambda _, key: responses[key]):
            helpers["main"]()

    def test_diagnosis_never_creates_an_acceptance_receipt(self):
        with tempfile.TemporaryDirectory() as directory:
            self.invoke(directory)
            root = Path(directory)
            self.assertFalse((root / "gui-completion.json").exists())
            self.assertIn('"product_acceptance": "not-run"', (root / "gui-diagnosis.json").read_text())
            self.assertIn("DIAGNOSIS ONLY", (root / "summary.md").read_text())

    def test_diagnosis_cannot_mix_completion_claims_or_bypass_artifact_gates(self):
        for overrides in ({"GUI_COMPLETION_RUN_ID": "456"}, {"GUI_EXPLORATION": "false"},
                          {"GITHUB_REF": "refs/heads/feature"}, {"APP_SOURCE_SHA": "c" * 40},
                          {"GUI_ACCEPTANCE_IN_CALLER": "true", "GITHUB_WORKFLOW": "Resume installed DMG acceptance"}):
            with tempfile.TemporaryDirectory() as directory, self.subTest(overrides=overrides), self.assertRaises(ValueError):
                self.invoke(directory, overrides)
        with tempfile.TemporaryDirectory() as directory, self.assertRaises(ValueError):
            self.invoke(directory, jobs=[dict(job, conclusion="failure") for job in self.jobs])


if __name__ == "__main__":
    unittest.main()
