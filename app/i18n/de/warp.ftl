settings-exec-profile-editor-call-mcp-servers = MCP-Server aufrufen
settings-exec-profile-editor-call-web-tools = Web-Werkzeuge aufrufen
settings-exec-profile-editor-call-web-tools-desc = Der Agent darf die Websuche nutzen, wenn sie beim Abschließen einer Aufgabe hilft.
settings-exec-profile-editor-directory-allowlist = Verzeichnisfreigabeliste
settings-exec-profile-editor-directory-allowlist-desc = Dem Agenten Dateizugriff auf bestimmte Verzeichnisse gewähren.
